    char_original_208 : array[8] of byte = (0,0,0,0,0,0,0,0);
    char_original_204 : array[8] of byte = (0,0,0,0,0,0,0,0);
    char_original_250 : array[8] of byte = (0,0,0,0,0,0,0,0);
