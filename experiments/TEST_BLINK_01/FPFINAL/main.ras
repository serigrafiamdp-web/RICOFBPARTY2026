procedure AvanzarSecuenciaVisual();
begin
    if show_stage < 25 then begin
        inc(show_stage);
    end;
    AplicarStageVisual();
end;
procedure RevisarFinalCentrado();
begin
    if final_center_hold_enabled = 1 then begin
        if final_center_hold_active = 0 then begin
            if show_stage = 26 then begin
                if scroll_end_armed = 1 then begin
                    if direction = final_center_direction then begin
                        if next_line = final_center_next_line then begin
                            if fine_scroll = final_center_fine_scroll then begin
                                radial_scroll_enabled := 0;
                                vertical_scroll_enabled := 0;
                                anim_active := 0;
                                final_center_hold_active := 1;
                                demo_finished := 1;
                            end;
                        end;
                    end;
                end;
            end;
        end;
    end;
end;
// | >>> PETSCII BASE LIMPIA / BACKUP DE LOS 4 CHARS                            |
procedure GuardarCharsOriginales();
begin
    asm("
        ldx #7
_char_backup_loop:
        lda $2678,x
        sta char_original_207,x
        lda $2680,x
        sta char_original_208,x
        lda $2660,x
        sta char_original_204,x
        lda $27D0,x
        sta char_original_250,x
        dex
        bpl _char_backup_loop
    ");
end;
procedure RestaurarCharsOriginales();
begin
    asm("
        ldx #7
_char_restore_loop:
        lda char_original_207,x
        sta $2678,x
        lda char_original_208,x
        sta $2680,x
        lda char_original_204,x
        sta $2660,x
        lda char_original_250,x
        sta $27D0,x
        dex
        bpl _char_restore_loop
    ");
end;
procedure ConfigurarAnimacionCombo();
begin
    n_izq := 0;
    n_der := 0;
    n_arriba := 0;
    n_abajo := 0;
    if anim_combo_stage = 0 then begin
        n_izq := 2;
        n_der := 2;
        chars_izq[0] := 207;
        chars_izq[1] := 208;
        chars_der[0] := 204;
        chars_der[1] := 250;
    end;
    if anim_combo_stage = 1 then begin
        n_der := 1;
        n_izq := 3;
        chars_der[0] := 207;
        chars_izq[0] := 208;
        chars_izq[1] := 204;
        chars_izq[2] := 250;
    end;
    if anim_combo_stage = 2 then begin
        n_der := 2;
        n_izq := 2;
        chars_der[0] := 207;
        chars_der[1] := 250;
        chars_izq[0] := 208;
        chars_izq[1] := 204;
    end;
    if anim_combo_stage = 3 then begin
        n_der := 2;
        n_izq := 2;
        chars_der[0] := 208;
        chars_der[1] := 250;
        chars_izq[0] := 207;
        chars_izq[1] := 204;
    end;
    if anim_combo_stage = 4 then begin
        n_der := 2;
        n_izq := 2;
        chars_der[0] := 207;
        chars_der[1] := 204;
        chars_izq[0] := 208;
        chars_izq[1] := 250;
    end;
    if anim_combo_stage = 5 then begin
        n_der := 2;
        n_arriba := 1;
        n_abajo := 1;
        chars_der[0] := 207;
        chars_der[1] := 250;
        chars_arriba[0] := 204;
        chars_abajo[0] := 208;
    end;
    if anim_combo_stage = 6 then begin
        n_abajo := 4;
        chars_abajo[0] := 207;
        chars_abajo[1] := 208;
        chars_abajo[2] := 204;
        chars_abajo[3] := 250;
    end;
    if anim_combo_stage = 7 then begin
        n_arriba := 4;
        chars_arriba[0] := 207;
        chars_arriba[1] := 208;
        chars_arriba[2] := 204;
        chars_arriba[3] := 250;
    end;
    if anim_combo_stage = 8 then begin
        n_der := 2;
        n_arriba := 1;
        n_abajo := 1;
        chars_der[0] := 208;
        chars_der[1] := 204;
        chars_abajo[0] := 207;
        chars_arriba[0] := 250;
    end;
    if anim_combo_stage = 9 then begin
        n_izq := 4;
        chars_izq[0] := 207;
        chars_izq[1] := 208;
        chars_izq[2] := 204;
        chars_izq[3] := 250;
    end;
end;
procedure ActualizarAnimacionEnNegro();
begin
    if anim_sequence_started = 0 then begin
        if anim_start_pending = 0 then begin
            if show_stage >= anim_start_show_stage then begin
                anim_start_pending := 1;
                anim_start_delay_counter := 0;
            end;
        end;
    end
    else begin
        if anim_active = 1 then begin
            if anim_combo_black_period < 1 then begin
                anim_combo_black_period := 1;
            end;
            inc(anim_combo_period_counter);
            if anim_combo_period_counter >= anim_combo_black_period then begin
                anim_combo_period_counter := 0;
                if anim_combo_stage < 9 then begin
                    RestaurarCharsOriginales();
                    inc(anim_combo_stage);
                    anim_counter := 0;
                    ConfigurarAnimacionCombo();
                end
                else begin
                    RestaurarCharsOriginales();
                    anim_active := 0;
                    anim_counter := 0;
                    n_izq := 0;
                    n_der := 0;
                    n_arriba := 0;
                    n_abajo := 0;
                end;
            end;
        end;
    end;
end;
procedure ActualizarInicioAnimacionPETSCII();
begin
    if anim_sequence_started = 0 then begin
        if anim_start_pending = 1 then begin
            if anim_start_delay_frames = 0 then begin
                anim_sequence_started := 1;
                anim_start_pending := 0;
                anim_combo_stage := 0;
                anim_combo_period_counter := 0;
                anim_counter := 0;
                GuardarCharsOriginales();
                RestaurarCharsOriginales();
                ConfigurarAnimacionCombo();
                anim_active := 1;
            end
            else begin
                inc(anim_start_delay_counter);
                if anim_start_delay_counter >= anim_start_delay_frames then begin
                    anim_sequence_started := 1;
                    anim_start_pending := 0;
                    anim_start_delay_counter := 0;
                    anim_combo_stage := 0;
                    anim_combo_period_counter := 0;
                    anim_counter := 0;
                    GuardarCharsOriginales();
                    RestaurarCharsOriginales();
                    ConfigurarAnimacionCombo();
                    anim_active := 1;
                end;
            end;
        end;
    end;
end;
procedure EventoPantallaNegra();
begin
    AvanzarSecuenciaVisual();
    ActualizarAnimacionEnNegro();
end;
procedure AnimarCaracterIndependiente();
begin
    anim_i := 0;
    while anim_i < n_izq do begin
        anim_idx := chars_izq[anim_i];
        asm("
            lda anim_idx
            sta $22
            lda #0
            sta $23
            asl $22
            rol $23
            asl $22
            rol $23
            asl $22
            rol $23
            clc
            lda $23
            adc #$20
            sta $23
            ldy #0
_char_izq_loop:
            lda ($22),y
            asl
            bcc _char_izq_store
            ora #$01
_char_izq_store:
            sta ($22),y
            iny
            cpy #8
            bne _char_izq_loop
        ");
        inc(anim_i);
    end;
    anim_i := 0;
    while anim_i < n_der do begin
        anim_idx := chars_der[anim_i];
        asm("
            lda anim_idx
            sta $22
            lda #0
            sta $23
            asl $22
            rol $23
            asl $22
            rol $23
            asl $22
            rol $23
            clc
            lda $23
            adc #$20
            sta $23
            ldy #0
_char_der_loop:
            lda ($22),y
            lsr
            bcc _char_der_store
            ora #$80
_char_der_store:
            sta ($22),y
            iny
            cpy #8
            bne _char_der_loop
        ");
        inc(anim_i);
    end;
    anim_i := 0;
    while anim_i < n_arriba do begin
        anim_idx := chars_arriba[anim_i];
        asm("
            lda anim_idx
            sta $22
            lda #0
            sta $23
            asl $22
            rol $23
            asl $22
            rol $23
            asl $22
            rol $23
            clc
            lda $23
            adc #$20
            sta $23
            ldy #0
            lda ($22),y
            pha
            ldy #1
_char_arriba_loop:
            lda ($22),y
            dey
            sta ($22),y
            iny
            iny
            cpy #8
            bne _char_arriba_loop
            ldy #7
            pla
            sta ($22),y
        ");
        inc(anim_i);
    end;
    anim_i := 0;
    while anim_i < n_abajo do begin
        anim_idx := chars_abajo[anim_i];
        asm("
            lda anim_idx
            sta $22
            lda #0
            sta $23
            asl $22
            rol $23
            asl $22
            rol $23
            asl $22
            rol $23
            clc
            lda $23
            adc #$20
            sta $23
            ldy #7
            lda ($22),y
            pha
            ldy #6
_char_abajo_loop:
            lda ($22),y
            iny
            sta ($22),y
            dey
            dey
            bpl _char_abajo_loop
            ldy #0
            pla
            sta ($22),y
        ");
        inc(anim_i);
    end;
end;
procedure InicializarMascaraSuperior();
begin
    asm("
        lda #$00
        ldx #$00
top_mask_charset_loop:
        sta $2800,x
        sta $2900,x
        sta $2A00,x
        sta $2B00,x
        sta $2C00,x
        sta $2D00,x
        sta $2E00,x
        sta $2F00,x
        inx
        bne top_mask_charset_loop
    ");
end;
procedure RenderizarBinarios();
begin
    vic_sprites := 0;
    asm("
        ldx #0
loop_limpiar_a:
        lda screen_lo,x
        sta $FB
        lda screen_hi,x
        sta $FC
        ldy #39
loop_espacios_a:
        lda #$20
        sta ($FB),y
        dey
        bpl loop_espacios_a
        inx
        cpx #25
        bne loop_limpiar_a
        lda #$20
        ldx #$00
clear_screen_b_pages:
        sta $3000,x
        sta $3100,x
        sta $3200,x
        inx
        bne clear_screen_b_pages
        ldx #$00
clear_screen_b_tail:
        sta $3300,x
        inx
        cpx #$E8
        bne clear_screen_b_tail
    ");
    AplicarColorActual();
end;
procedure CambiarBufferPantalla();
begin
    asm("
        lda screen_active
        beq switch_screen_to_b
        lda #$00
        sta screen_active
        lda #$18
        sta screen_d018_real
        lda #$1A
        sta screen_d018_mask
        jmp switch_screen_apply
switch_screen_to_b:
        lda #$01
        sta screen_active
        lda #$C8
        sta screen_d018_real
        lda #$CA
        sta screen_d018_mask
switch_screen_apply:
        lda screen_d018_real
        ; NTSC: preserve the masked top row during a buffer change.
        ; Same three-byte instruction footprint as the original STA.
        jsr $8B70
    ");
end;
procedure PrepararBufferArriba();
begin
    src_idx := 255;
    map_idx := next_line;
    if map_idx >= 30 then begin
        if map_idx < 90 then begin
            src_idx := map_idx - 30;
        end;
    end;
    asm("
        lda screen_active
        beq prep_up_a_to_b
        jmp prep_up_b_to_a
prep_up_a_to_b:
        ldy #$00
prep_up_ab_0:
        lda $0428,y
        sta $3000,y
        iny
        bne prep_up_ab_0
        ldy #$00
prep_up_ab_1:
        lda $0528,y
        sta $3100,y
        iny
        bne prep_up_ab_1
        ldy #$00
prep_up_ab_2:
        lda $0628,y
        sta $3200,y
        iny
        bne prep_up_ab_2
        ldy #$00
prep_up_ab_3:
        lda $0728,y
        sta $3300,y
        iny
        cpy #192
        bne prep_up_ab_3
        lda #$C0
        sta $FB
        lda #$33
        sta $FC
        jmp prep_up_copy_done
prep_up_b_to_a:
        ldy #$00
prep_up_ba_0:
        lda $3028,y
        sta $0400,y
        iny
        bne prep_up_ba_0
        ldy #$00
prep_up_ba_1:
        lda $3128,y
        sta $0500,y
        iny
        bne prep_up_ba_1
        ldy #$00
prep_up_ba_2:
        lda $3228,y
        sta $0600,y
        iny
        bne prep_up_ba_2
        ldy #$00
prep_up_ba_3:
        lda $3328,y
        sta $0700,y
        iny
        cpy #192
        bne prep_up_ba_3
        lda #$C0
        sta $FB
        lda #$07
        sta $FC
prep_up_copy_done:
    ");
    if src_idx < 60 then begin
        asm("
            ldx src_idx
            lda src_char_lo,x
            sta $22
            lda src_char_hi,x
            sta $23
            ldy #39
prep_up_inject_real:
            lda ($22),y
            sta ($FB),y
            dey
            bpl prep_up_inject_real
        ");
    end
    else begin
        asm("
            lda #$20
            ldy #39
prep_up_inject_space:
            sta ($FB),y
            dey
            bpl prep_up_inject_space
        ");
    end;
end;
procedure PrepararBufferAbajo();
begin
    map_idx := next_line;
    if map_idx > 0 then begin
        dec(map_idx);
    end;
    src_idx := 255;
    if map_idx >= 25 then begin
        map_idx := map_idx - 25;
        if map_idx >= 30 then begin
            if map_idx < 90 then begin
                src_idx := map_idx - 30;
            end;
        end;
    end;
    asm("
        lda screen_active
        beq prep_down_a_to_b
        jmp prep_down_b_to_a
prep_down_a_to_b:
        ldy #$00
prep_down_ab_0:
        lda $0400,y
        sta $3028,y
        iny
        bne prep_down_ab_0
        ldy #$00
prep_down_ab_1:
        lda $0500,y
        sta $3128,y
        iny
        bne prep_down_ab_1
        ldy #$00
prep_down_ab_2:
        lda $0600,y
        sta $3228,y
        iny
        bne prep_down_ab_2
        ldy #$00
prep_down_ab_3:
        lda $0700,y
        sta $3328,y
        iny
        cpy #192
        bne prep_down_ab_3
        lda #$00
        sta $FB
        lda #$30
        sta $FC
        jmp prep_down_copy_done
prep_down_b_to_a:
        ldy #$00
prep_down_ba_0:
        lda $3000,y
        sta $0428,y
        iny
        bne prep_down_ba_0
        ldy #$00
prep_down_ba_1:
        lda $3100,y
        sta $0528,y
        iny
        bne prep_down_ba_1
        ldy #$00
prep_down_ba_2:
        lda $3200,y
        sta $0628,y
        iny
        bne prep_down_ba_2
        ldy #$00
prep_down_ba_3:
        lda $3300,y
        sta $0728,y
        iny
        cpy #192
        bne prep_down_ba_3
        lda #$00
        sta $FB
        lda #$04
        sta $FC
prep_down_copy_done:
    ");
    if src_idx < 60 then begin
        asm("
            ldx src_idx
            lda src_char_lo,x
            sta $22
            lda src_char_hi,x
            sta $23
            ldy #39
prep_down_inject_real:
            lda ($22),y
            sta ($FB),y
            dey
            bpl prep_down_inject_real
        ");
    end
    else begin
        asm("
            lda #$20
            ldy #39
prep_down_inject_space:
            sta ($FB),y
            dey
            bpl prep_down_inject_space
        ");
    end;
end;
procedure DesplazarArriba();
begin
    scroll_coarse_event := 1;
    if next_line = 30 then begin
        if sid_start_on_first_content = 1 then begin
            if sid_first_content_triggered = 0 then begin
                sid_first_content_triggered := 1;
                sid_ramp_active := sid_ramp_enabled;
                sid_ramp_frame_counter := 0;
                sid_ramp_block_counter := 0;
            end;
        end;
    end;
    CambiarBufferPantalla();
    inc(next_line);
    PrepararBufferArriba();
end;
procedure DesplazarAbajo();
begin
    scroll_coarse_event := 1;
    CambiarBufferPantalla();
    if next_line > 0 then begin
        dec(next_line);
    end;
    PrepararBufferAbajo();
end;
interrupt SidRasterIRQ();
begin
    StartIRQ(@useKernal);
    asm("
        lda top_mask_enabled
        beq sid_irq_mask_disabled
        lda top_mask_phase
        beq sid_irq_mask_begin
        lda fine_scroll
        and #$07
        cmp #$04
        beq top_mask_restore_charset
        nop
        nop
        nop
        nop
        nop
top_mask_restore_charset:
        lda screen_d018_real
        sta $D018
        lda #$00
        sta top_mask_phase
        sta $D012
        jmp sid_irq_done
sid_irq_mask_begin:
        lda screen_d018_mask
        sta $D018
        lda #$01
        sta top_mask_phase
        lda top_mask_restore_raster
        sec
        sbc #$01
        ; PRUEBA NTSC: fijar fin de la primera fila al raster 63.
        ; Los PAL conservan exactamente el raster 60 original.
        jsr $8BA0
        jmp sid_irq_music_entry
sid_irq_mask_disabled:
        lda screen_d018_real
        sta $D018
        lda #$00
        sta top_mask_phase
        sta $D012
sid_irq_music_entry:
        ; ------------------------------------------------------------
        ; FIX14 - RELOJ LOGICO COMUN PAL / NTSC / DREAN PAL-N
        ;
        ; detected_machine:
        ; 1 = NTSC OLD 262x64  -> 37 ticks cada 45 frames
        ; 2 = NTSC NEW 263x65  -> 31 ticks cada 37 frames
        ; 3 = PAL-B            -> tick cada frame
        ; 4 = DREAN PAL-N      -> tick cada frame
        ;
        ; IMPORTANTE: solo regulamos CUANDO se llama al player.
        ; NO tocamos frecuencias SID, por lo que cada maquina mantiene
        ; su afinacion natural.
        ; ------------------------------------------------------------

        lda detected_machine
        cmp #1
        beq sid_logic_ntsc_old
        cmp #2
        beq sid_logic_ntsc_new

sid_logic_pal_family:
        lda #1
        sta demo_logic_tick
        jmp sid_logic_tick_ready

sid_logic_ntsc_old:
        lda demo_tick_accum
        clc
        adc #37
        cmp #45
        bcc sid_logic_skip_frame
        sbc #45
        sta demo_tick_accum

        ; FIX18: acumular tick visual sin frenar SID.
        lda demo_logic_tick
        cmp #$FF
        beq sid_logic_ntsc_old_tick_queued
        inc demo_logic_tick
sid_logic_ntsc_old_tick_queued:
        jmp sid_logic_tick_ready

sid_logic_ntsc_new:
        lda demo_tick_accum
        clc
        adc #31
        cmp #37
        bcc sid_logic_skip_frame
        sbc #37
        sta demo_tick_accum

        ; FIX18: acumular tick visual sin frenar SID.
        lda demo_logic_tick
        cmp #$FF
        beq sid_logic_ntsc_new_tick_queued
        inc demo_logic_tick
sid_logic_ntsc_new_tick_queued:
        jmp sid_logic_tick_ready

sid_logic_skip_frame:
        sta demo_tick_accum
        ; FIX18: NO borrar demo_logic_tick. Puede haber trabajo visual pendiente.
        jmp sid_irq_done

sid_logic_tick_ready:
        lda sid_end_state
        beq sid_irq_normal_mode
        cmp #1
        beq sid_irq_tail_mode
        jmp sid_irq_done
sid_irq_tail_mode:
        inc sid_tail_counter
        lda sid_tail_counter
        cmp sid_tail_frames
        bcs sid_irq_tail_finish
        jmp sid_irq_done
sid_irq_tail_finish:
        lda $D418
        and #$F0
        sta $D418
        lda #$00
        sta $D404
        sta $D40B
        sta $D412
        lda #2
        sta sid_end_state
        jmp sid_irq_done
sid_irq_normal_mode:
        lda sid_ramp_active
        beq sid_ramp_finished
        inc sid_ramp_frame_counter
        lda sid_ramp_frame_counter
        cmp #8
        bcc sid_ramp_finished
        lda #$00
        sta sid_ramp_frame_counter
        lda sid_gradient
        bne sid_gradient_not_zero
        lda #1
sid_gradient_not_zero:
        cmp #11
        bcc sid_gradient_valid
        lda #10
sid_gradient_valid:
        tax
        dex
        lda sid_gradient_table,x
        sta sid_gradient_blocks
        inc sid_ramp_block_counter
        lda sid_ramp_block_counter
        cmp sid_gradient_blocks
        bcc sid_ramp_finished
        lda #$00
        sta sid_ramp_block_counter
        lda sid_rate
        cmp sid_ramp_target_rate
        beq sid_ramp_finished
        bcc sid_ramp_up
sid_ramp_down:
        sec
        sbc #1
        sta sid_rate
        jmp sid_ramp_finished
sid_ramp_up:
        clc
        adc #1
        sta sid_rate
sid_ramp_finished:
        lda scroll_sid_link
        bne sid_scroll_link_active
        jmp sid_scroll_manual
sid_scroll_link_active:
        lda sid_rate
        cmp scroll_rate_fast
        bcc sid_scroll_not_fast
        jmp sid_scroll_fast
sid_scroll_not_fast:
        cmp scroll_rate_mid2
        bcs sid_scroll_smooth_transition
        cmp scroll_rate_mid1
        bcs sid_scroll_mid1
sid_scroll_slow:
        lda scroll_speed_slow
        sta scroll_speed
        lda #128
        sta scroll_phase_step
        lda #0
        sta scroll_fullspeed
        sta scroll_turbo_base_extra
        sta scroll_turbo_frac_step
        jmp sid_scroll_finished
sid_scroll_mid1:
        lda scroll_speed_mid1
        sta scroll_speed
        lda #128
        sta scroll_phase_step
        lda #0
        sta scroll_fullspeed
        sta scroll_turbo_base_extra
        sta scroll_turbo_frac_step
        jmp sid_scroll_finished
sid_scroll_smooth_transition:
        lda scroll_speed_mid2
        sta scroll_speed
        lda sid_rate
        sec
        sbc scroll_rate_mid2
        cmp #10
        bcc sid_scroll_smooth_index_ok
        lda #9
sid_scroll_smooth_index_ok:
        tax
        lda scroll_smooth_table,x
        sta scroll_phase_step
        lda #0
        sta scroll_fullspeed
        sta scroll_turbo_base_extra
        sta scroll_turbo_frac_step
        jmp sid_scroll_finished
sid_scroll_fast:
        lda scroll_speed_fast
        sta scroll_speed
        lda #1
        sta scroll_fullspeed
        lda #0
        sta scroll_turbo_base_extra
        sta scroll_turbo_frac_step
        lda scroll_turbo_enabled
        beq sid_scroll_finished
        lda scroll_turbo_active
        beq sid_scroll_finished
        lda scroll_turbo_stage
        cmp #11
        bcc sid_scroll_turbo_stage_ok
        lda #10
sid_scroll_turbo_stage_ok:
        tax
        lda scroll_turbo_base_table,x
        sta scroll_turbo_base_extra
        lda scroll_turbo_frac_table,x
        sta scroll_turbo_frac_step
        jmp sid_scroll_finished
sid_scroll_manual:
        lda scroll_speed_manual
        sta scroll_speed
        lda #0
        sta scroll_fullspeed
        sta scroll_turbo_base_extra
        sta scroll_turbo_frac_step
sid_scroll_finished:
        lda sid_accum
        clc
        adc sid_rate
        cmp #50
        bcs sid_irq_do_play
        sta sid_accum
        jmp sid_irq_done
sid_irq_do_play:
        sbc #50
        sta sid_accum
        jsr $9003

        ; ---------------------------------------------------------
        ; FIX40: click-safe music fade-in.
        ; VICIOS writes desired D418 to shadow $33F0.
        ; Real D418 receives min(tune volume, fade ceiling).
        ; ---------------------------------------------------------
        lda $33F0
        and #$0F
        sta startup_intro_seconds

        lda startup_intro_fps
        cmp startup_intro_seconds
        bcc fix40_use_ceiling
        lda startup_intro_seconds
        jmp fix40_volume_ready

fix40_use_ceiling:
        lda startup_intro_fps

fix40_volume_ready:
        sta startup_intro_seconds
        lda $33F0
        and #$F0
        ora startup_intro_seconds
        sta $D418

        ; FIX46: identical final master volume on confirmed SID2.
        pha
        lda hardware_profile
        beq fix46_volume_done
        pla
        jsr $CEE2
        jmp fix46_volume_after
fix46_volume_done:
        pla
fix46_volume_after:

        ; Softer ramp: one volume step every 10 PLAY calls.
        ; 15 steps x 10 PLAYs = 150 PLAYs â 3.0 s at 50 Hz.
        lda startup_intro_fps
        cmp #$0F
        bcs fix40_music_fade_done

        inc startup_intro_frame_counter
        lda startup_intro_frame_counter
        cmp #$0A
        bcc fix40_music_fade_done
        lda #$00
        sta startup_intro_frame_counter
        inc startup_intro_fps

fix40_music_fade_done:
        inc sid_play_count_lo
        bne sid_play_count_ready
        inc sid_play_count_hi
sid_play_count_ready:
        lda scroll_turbo_enabled
        beq sid_turbo_trigger_done
        lda scroll_turbo_active
        bne sid_turbo_progress
        lda sid_play_count_hi
        cmp scroll_turbo_trigger_hi
        bcc sid_turbo_trigger_done
        bne sid_turbo_begin
        lda sid_play_count_lo
        cmp scroll_turbo_trigger_lo
        bcc sid_turbo_trigger_done
sid_turbo_begin:
        lda #1
        sta scroll_turbo_active
        lda #0
        sta scroll_turbo_stage
        sta scroll_turbo_stage_counter
        jmp sid_turbo_trigger_done
sid_turbo_progress:
        lda scroll_turbo_stage
        cmp #10
        bcs sid_turbo_trigger_done
        inc scroll_turbo_stage_counter
        lda scroll_turbo_stage_counter
        cmp scroll_turbo_stage_plays
        bcc sid_turbo_trigger_done
        lda #0
        sta scroll_turbo_stage_counter
        inc scroll_turbo_stage
sid_turbo_trigger_done:
        lda sid_end_enabled
        bne sid_end_check
        jmp sid_irq_done
sid_end_check:
        lda sid_play_count_hi
        cmp sid_end_play_hi
        bcs sid_end_hi_reached
        jmp sid_irq_done
sid_end_hi_reached:
        bne sid_begin_end
        lda sid_play_count_lo
        cmp sid_end_play_lo
        bcs sid_begin_end
        jmp sid_irq_done
sid_begin_end:
        ; FIX19: congelar el SID exactamente en el ultimo PLAY valido.
        ; No GATE OFF, no volumen 0, no tocar voces.
        ; Estado 2 evita cualquier PLAY posterior.
        lda #2
        sta sid_end_state
        ; NTSC: stop the SID at the original PLAY count but let the final
        ; upward PETSCII sequence (stage 24) finish before blacking the screen.
        ; PAL-B / PAL-N: exact original end behavior.
        lda detected_machine
        cmp #3
        bcc sid_end_ntsc_visual_pending
        lda #1
        sta demo_finished
sid_end_ntsc_visual_pending:
        lda #0
        sta sid_tail_counter
        sta sid_ramp_active
        jmp sid_irq_done
sid_irq_done:
    ");
    CloseIRQ();
end;
// |                    >>> RETORNO LIMPIO A BASIC <<<                            |
// |              >>> BASIC REAL ACTIVO / ESTETICA EPYX TOOLKIT <<<              |
// | - restaura KERNAL y BASIC reales                                             |
// |                 >>> VOTE RICO? / Y-N FINAL <<<                              |
// | Y = salir al BASIC real                                                     |
// |              >>> SALIDA INMEDIATA AL BASIC REAL <<<                         |
procedure SalirABasicReal();
begin
    asm("
_vote_basic_exit_common:
        sei
        cld
        ; Restaurar VIC solo desde outro; silenciar SID2 en TODA salida.
        ; RUN/STOP durante DEMO (incluso despues de N) tambien apaga SID2.
        lda basic_return_counter
        cmp #$FF
        bne outro_ocean_basic_mute_sid2
        lda #$1B               ; VIC normal al salir, aunque V lo oculto.
        sta $D011
outro_ocean_basic_mute_sid2:
        ldx hardware_profile
        beq outro_ocean_basic_no_sid2
        lda intro_sid2_base_lo,x
        sta $FB
        lda intro_sid2_base_hi,x
        sta $FC
        lda #$00
        ldy #$04
        sta ($FB),y
        ldy #$0B
        sta ($FB),y
        ldy #$12
        sta ($FB),y
        ldy #$18
        sta ($FB),y
outro_ocean_basic_no_sid2:
        ldx #$FF
        txs
        lda #$00
        sta $D01A
        lda #$0F
        sta $D019
        lda #$00
        sta $D404
        sta $D40B
        sta $D412
        sta $D418
        lda #$37
        sta $01
        jsr $FF84             ; IOINIT
        jsr $FF87             ; RAMTAS
        jsr $FF8A             ; RESTOR
        jsr $FF81             ; CINT
        jsr $E453             ; vectores BASIC
        jsr $E3BF             ; workspace / CHRGET
        jsr $E422             ; punteros / startup
        jsr $FFCC             ; CLRCHN
        cli
        jmp $A474             ; READY.

    ");
end;
// |  >>> N: DEMO DIRECTA / S: REPETIR SYSINFO 64 Y DESPUES DEMO <<<          |
procedure ReiniciarDemoDesdeOutro();
begin
    asm("
restart_s_irq_safe_entry:
        sei
        ; Tras detectar S, este punto se alcanza sin CLI intermedio.
        ; El loader del outro dejÃ³ la musica y raster IRQ detenidos.
        ; Asegurar estado silencioso, sin tocar la deteccion ya efectuada.
        lda #$00
        sta $D01A
        sta $D015
        sta $D404
        sta $D40B
        sta $D412
        sta $D418
        lda #$0F
        sta $D019
        ; Apagar tambien SID2, si SYSINFO lo habia detectado.
        ldx hardware_profile
        beq restart_no_sid2
        lda intro_sid2_base_lo,x
        sta $FB
        lda intro_sid2_base_hi,x
        sta $FC
        lda #$00
        ldy #$04
        sta ($FB),y
        ldy #$0B
        sta ($FB),y
        ldy #$12
        sta ($FB),y
        ldy #$18
        sta ($FB),y
restart_no_sid2:
        lda #$35               ; RAM visible bajo KERNAL
        sta $01
        ; N y S vuelven a la escala MASTER sin modificar los BIN de disco.
        jsr $F6DE              ; restaurar gris Y desactivar ciclo 0..9, RAM visible $35.
        jsr $8000              ; restaurar charset original (23 glifos)
        lda #$1B               ; restaurar DEN al reiniciar con N.
        sta $D011
        ; El contador FF significaba outro. El test debe empezar limpio.
        lda #$00
        sta basic_return_counter
        ; S=3: volver a SYSINFO; N=2: saltarlo como antes.
        lda escape_requested
        cmp #$03
        beq restart_full_sysinfo
        lda #$02
        bne restart_store_entry_mode
restart_full_sysinfo:
        ; S: recuperar banking del inicio y entrar DIRECTAMENTE al test.
        ; Se evita pasar por el condicional del reinicio general, que en
        ; la prueba anterior siguio saltando SYSINFO.
        lda #$37
        sta $01
        lda #$03
        sta startup_intro_done
        ldx #$FF
        txs
        jmp demo_sysinfo_force_entry
restart_store_entry_mode:
        sta startup_intro_done
        ldx #$FF
        txs                    ; descartar pila del loop anterior
        jmp demo_restart_entry ; N: reset sin test (comportamiento aprobado)
    ");
end;
// |          >>> ESC EMULADOR / RUN-STOP C64 / POLL DIRECTO <<<                |
procedure ChequearEscape();
begin
    escape_requested := 0;
    asm("
        sei
        lda $DC00
        pha
        lda $DC02
        pha
        lda $DC03
        pha
        lda #$FF
        sta $DC02
        lda #$00
        sta $DC03
        lda #$7F
        sta $DC00
        ; RUN/STOP (PA7, PB7): salida a BASIC en cualquier momento.
        lda $DC01
        and #$80
        bne _outro_keyboard_gate
        jmp _escape_pressed
_outro_keyboard_gate:
        ; S tambien funciona en la DEMO (este polling corre tras WaitVBlank).
        ; Y/N/V siguen siendo exclusivas del outro y conservan prioridad.
        lda basic_return_counter
        cmp #$FF
        beq _outro_keyboard_scan
        jmp _check_restart_sysinfo
_outro_keyboard_scan:
        ; Antes de Y, descartar falso PB1 por joystick 1 hacia abajo.
        lda #$FF
        sta $DC00
        lda $DC01
        and #$02
        beq _check_vote_no
        ; Y: PA3=$F7, PB1=$02 (prioridad sobre N y V).
        lda #$F7
        sta $DC00
        lda $DC01
        and #$02
        bne _check_vote_no
        jmp _escape_pressed
_check_vote_no:
        ; N: PA4=$EF, PB7=$80. Reinicio sin SYSINFO ya probado.
        lda #$EF
        sta $DC00
        lda $DC01
        and #$80
        bne _check_restart_sysinfo
        lda #$02
        sta escape_requested
        jmp _escape_not_pressed
_check_restart_sysinfo:
        ; S: PA1=$FD, PB5=$20. Disponible en DEMO y en OUTRO.
        ; Latch: una sola solicitud por pulsacion, hasta soltar S.
        lda #$FD
        sta $DC00
        lda $DC01
        and #$20
        bne _s_key_released
        lda demo_s_key_latch
        beq _s_key_new_press
        jmp _escape_not_pressed
_s_key_new_press:
        lda #$01
        sta demo_s_key_latch
        lda #$03
        sta escape_requested
        jmp _escape_not_pressed
_s_key_released:
        lda #$00
        sta demo_s_key_latch
        ; OUTRO: V intacta. DEMO: scan matricial 0..9 en modulo $811E.
        lda basic_return_counter
        cmp #$FF
        beq _check_toggle_v
        lda demo_finished
        bne _escape_not_pressed
        jsr demo_o_outro_probe ; O -> demo_finished; otra -> paleta $811E.
        jmp _escape_not_pressed
_check_toggle_v:
        ; V: PA3=$F7, PB7=$80. Un cambio por PULSACION.
        lda #$F7
        sta $DC00
        lda $DC01
        and #$80
        beq _v_key_down
        ; Al soltar V se habilita la siguiente pulsacion.
        lda #$00
        sta outro_v_key_latch
        jmp _escape_not_pressed
_v_key_down:
        lda outro_v_key_latch
        beq _v_new_press
        jmp _escape_not_pressed
_v_new_press:
        lda #$01
        sta outro_v_key_latch
        ; OUTRO siempre configura D011=$1B y borde negro.
        ; DEN bit4=0 => imagen oculta ($0B); bit4=1 => imagen ($1B).
        ; No escribir de vuelta el bit7 leido de D011 (raster MSB).
        lda $D011
        and #$10
        beq _v_show_display
        lda #$0B
        jmp _v_write_display
_v_show_display:
        lda #$1B
_v_write_display:
        sta $D011
        jmp _escape_not_pressed
_escape_pressed:
        lda #$01
        sta escape_requested
_escape_not_pressed:
        pla
        sta $DC03
        pla
        sta $DC02
        pla
        sta $DC00
        ; S: con IRQ aun enmascaradas, saltar al reinicio completo.
        ; En DEMO habia una ventana CLI -> llamada Pascal -> SEI que
        ; no existe en OUTRO. Y/N/V/RUNSTOP conservan su flujo previo.
        lda escape_requested
        cmp #$03
        bne _escape_restore_irq
        jmp restart_s_irq_safe_entry
_escape_restore_irq:
        cli
    ");
    if escape_requested = 1 then begin
        SalirABasicReal();
    end;
    if escape_requested = 2 then begin
        ReiniciarDemoDesdeOutro();
    end;
    if escape_requested = 3 then begin
        ReiniciarDemoDesdeOutro();
    end;
end;
// PALETAS 0..9: detector original intacto; aplicacion diferida en BIN $811E.
// Cada llamada hace como maximo 64 bytes y permite un ultimo pedido en cola.
// En el reinicio N/S, $81CE termina la cola y restaura gris con IRQ detenidas.
procedure AlternarPaletasDemo();
begin
    asm("
        jsr $F660  ; RAM bajo KERNAL ya visible por SetMemoryConfig(1,@useKernal,0).
    ");
end;
// OUTRO: audio EXACTO de INTRO ($3A64 init, $8400 init, $3A00+ $8403 tick,
// $8409 hold), con reloj propio; la animacion de filas divididas sigue intacta.
// VISUAL ORIGINAL: fase cada 4 cuadros; pixels y caracteres cada 8 cuadros.
// Arriba 207/208 opuesto a abajo 204/250; direccion se invierte con el
// paneo del SID2 exactamente en el intervalo de fases de la intro.
// Las olas pasan a gris oscuro ($0B); linea 25: texto gris claro ($0F).
procedure InicializarOutroMar();
begin
    // V solo en el outro: cada entrada empieza con la tecla liberada.
    outro_v_key_latch := 0;
    n_izq := 2;
    n_der := 2;
    n_arriba := 0;
    n_abajo := 0;
    chars_izq[0] := 207;
    chars_izq[1] := 208;
    chars_der[0] := 204;
    chars_der[1] := 250;
    anim_counter := 0;
    asm("
        ldx #$00
outro_sea_white_page0:
        lda $0400,x
        cmp #$CC
        beq outro_sea_white_0
        cmp #$CF
        beq outro_sea_white_0
        cmp #$D0
        beq outro_sea_white_0
        cmp #$FA
        bne outro_sea_white_page1_check
outro_sea_white_0:
        lda #$0B
        sta $D800,x
outro_sea_white_page1_check:
        lda $0500,x
        cmp #$CC
        beq outro_sea_white_1
        cmp #$CF
        beq outro_sea_white_1
        cmp #$D0
        beq outro_sea_white_1
        cmp #$FA
        bne outro_sea_white_page2_check
outro_sea_white_1:
        lda #$0B
        sta $D900,x
outro_sea_white_page2_check:
        lda $0600,x
        cmp #$CC
        beq outro_sea_white_2
        cmp #$CF
        beq outro_sea_white_2
        cmp #$D0
        beq outro_sea_white_2
        cmp #$FA
        bne outro_sea_white_page3_check
outro_sea_white_2:
        lda #$0B
        sta $DA00,x
outro_sea_white_page3_check:
        cpx #$E8
        bcs outro_sea_white_next
        lda $0700,x
        cmp #$CC
        beq outro_sea_white_3
        cmp #$CF
        beq outro_sea_white_3
        cmp #$D0
        beq outro_sea_white_3
        cmp #$FA
        bne outro_sea_white_next
outro_sea_white_3:
        lda #$0B
        sta $DB00,x
outro_sea_white_next:
        inx
        beq outro_sea_white_done
        jmp outro_sea_white_page0
outro_sea_white_done:
        ; Iniciar EXACTAMENTE el motor de audio probado de la intro, una vez
        ; cargados mapa, colores y charset. El MUSIC IRQ esta detenido.
        ; No ejecutar el antiguo helper grafico $3ABC: animaria $2800, no
        ; el charset $2000 que ahora usa la pantalla de la outro.
        lda #$00
        sta startup_intro_fps
        sta sid_ramp_frame_counter
        sta outro_audio_phase   ; audio clonado parte de fase 0
        sta outro_audio_divider ; independiente del reloj visual original
        sta $3B46              ; mismo divisor de animacion que la intro.
        sta $3B9E              ; misma cadencia de paneo del helper $1800.
        sta $3B9F              ; desplazamiento de 0 a 15 pixeles.
        sta $D417             ; quitar ruteo de filtro residual de VICIOS.
        sta $D404
        sta $D40B
        sta $D412
        lda #$90
        sta $D413
        lda #$FA
        sta $D414
        lda #$0F
        sta $D418
        lda #$81
        sta $D412

        ; SID2 opcional: solo la direccion realmente detectada por RicOS.
        ldx hardware_profile
        beq outro_ocean_sid_ready
        lda intro_sid2_base_lo,x
        sta $FB
        lda intro_sid2_base_hi,x
        sta $FC
        lda #$00
        ldy #$04
        sta ($FB),y
        ldy #$0B
        sta ($FB),y
        ldy #$12
        sta ($FB),y
        ldy #$17
        sta ($FB),y
        ldy #$13
        lda #$90
        sta ($FB),y
        iny
        lda #$FA
        sta ($FB),y
        ldy #$18
        lda #$0F
        sta ($FB),y
        ldy #$12
        lda #$80
        sta ($FB),y
outro_ocean_sid_ready:
        ; Mismo arranque sonoro completo que la INTRO: lecho y voces,
        ; generador de ruido, cutoff -$20, volumen aprobado y fade-in.
        ; El audio original de OUTRO queda sustituido, no mezclado.
        jsr $3A64
        ldx hardware_profile
        jsr $F900
        jsr $8B07             ; OUTRO: iniciar linea 25 y adelantar fade del mar al nivel 2.
        lda #$00
        sta outro_text_speed10_counter
    ");
end;

procedure ActualizarOutroMar();
begin
    // El bucle principal ya llama WaitVBlank. VISUAL SIN CAMBIOS:
    // fase propia cada 4 cuadros; caracteres y paneo cada 8.
    // AUDIO: fase independiente con calma, ascenso 4, quiebre retenido,
    // espuma, retirada, filtro y volumen clonados de INTRO.
    // Conservar las franjas 207/208 arriba, 204/250 abajo, charset $2000.
    asm("
        inc sid_ramp_frame_counter
        lda sid_ramp_frame_counter
        and #$03
        bne outro_ocean_keep_phase
        inc startup_intro_fps
outro_ocean_keep_phase:
        ; MOTOR SONORO DE INTRO, sin tocar la fase que gobierna el dibujo.
        ; La rutina visual de abajo conserva startup_intro_fps y $F100.
        lda outro_audio_phase
        and #$7F
        cmp #$60              ; quiebre global $60/$E0
        bne outro_audio_step
        ldx detected_machine
        jsr $8409             ; mismo hold de espuma que INTRO
        beq outro_audio_render
        inc outro_audio_phase
        lda #$08
        sta outro_audio_divider
        jmp outro_audio_render
outro_audio_step:
        inc outro_audio_divider
        lda outro_audio_phase
        and #$7F
        cmp #$10
        bcc outro_audio_normal
        cmp #$20
        bcs outro_audio_normal
        lda outro_audio_divider
        and #$0F              ; calma: 16 cuadros por paso
        bne outro_audio_render
        jmp outro_audio_advance
outro_audio_normal:
        lda outro_audio_phase
        and #$7F
        cmp #$20
        bcc outro_audio_eight
        cmp #$60
        bcs outro_audio_eight
        lda outro_audio_divider
        and #$07
        cmp #$04              ; ascenso aprobado: 4 cuadros por paso
        bne outro_audio_render
        lda #$00
        sta outro_audio_divider
        jmp outro_audio_advance
outro_audio_eight:
        lda outro_audio_divider
        and #$07              ; resto: 8 cuadros por paso
        bne outro_audio_render
outro_audio_advance:
        inc outro_audio_phase
outro_audio_render:
        ; Asegurar puntero SID2: scroll de texto/charset puede usar ZP.
        ; Con SID unico, no efectuar ningun acceso a un segundo chip.
        ldx hardware_profile
        beq outro_audio_sid_ready
        lda intro_sid2_base_lo,x
        sta $FB
        lda intro_sid2_base_hi,x
        sta $FC
outro_audio_sid_ready:
        lda outro_audio_phase
        ldx hardware_profile
        jsr $3A00             ; frecuencias y GATE identicos a INTRO
        lda outro_audio_phase
        ldx hardware_profile
        jsr $F903             ; OUTRO-only: motor aprobado + alternancia voz extra.
        ; A PARTIR DE AQUI, VISUAL DE OUTRO ORIGINAL INTACTO.
        inc $3B46
        lda $3B46
        and #$07
        sta anim_counter
    ");
    if anim_counter = 0 then begin
        AnimarCaracterIndependiente();
    end;
    // Igual que la intro: desplazamiento de pixels y de codigos cada
    // ocho cuadros. Se refrescan las seis copias DESPUES de rotar los
    // cuatro caracteres originales para que formas y posiciones coincidan.
    // A=fase del oceano; X=SID2 detectado, igual que en $1800.
    asm("
        lda startup_intro_fps
        ldx hardware_profile
        jsr $F100
        jsr $FF34             ; esperar ~10 s desde la outro; luego scroll cada 8 cuadros.
        ; SOLO texto de linea 25: +10% de velocidad MEDIA de desplazamiento.
        ; El BIN da 1 tick/frame (1 caracter/8 ticks). Tras la espera,
        ; agregar exactamente 1 tick cada 10 frames = 11/10 ticks/frame.
        ; No acelerar la espera, el oceano, musica, animaciones ni VOTE.
        lda $FF7C             ; estado BIN: 2 = scroll activo
        cmp #$02
        bne outro_text_speed10_inactive
        inc outro_text_speed10_counter
        lda outro_text_speed10_counter
        cmp #$0A
        bcc outro_text_speed10_done
        lda #$00
        sta outro_text_speed10_counter
        jsr $F203             ; solo 1 tick de texto adicional
        jmp outro_text_speed10_done
outro_text_speed10_inactive:
        lda #$00
        sta outro_text_speed10_counter
outro_text_speed10_done:
        jsr $FF7F             ; blink solo letras VOTE, amarillo/blanco, sin invertir.
    ");
end;

// OUTRO STAGE 1: after the same black pause, mute SID2 and load the new
// static artwork. Preserve the original immediate RUN/STOP -> BASIC procedure.
procedure FinalizarDemoEnBasic();
begin
    asm("
_vote_yes:
        ; Unico punto de apagado: nunca silenciar antes de Y.
        sei
        lda hardware_profile  ; 0=no SID2, 1=DE00, 2=D420, 3=D500
        beq _vote_yes_basic
        tax
        lda intro_sid2_base_lo,x
        sta $FB
        lda intro_sid2_base_hi,x
        sta $FC
        lda #$00
        ldy #$04             ; SID2: voice 1 GATE OFF
        sta ($FB),y
        ldy #$0B             ; SID2: voice 2 GATE OFF
        sta ($FB),y
        ldy #$12             ; SID2: voice 3 GATE OFF
        sta ($FB),y
        ldy #$18             ; SID2: master volume 0
        sta ($FB),y
_vote_yes_basic:
        ; OUTRO STAGE 1: same SID2 shutdown, but load static art instead of BASIC.
        ; Map out KERNAL so the new data/code under $E000/$F000 are readable.
        lda #$35
        sta $01
        jmp $F000
    ");
end;
// |                           >>> PROGRAMA PRINCIPAL <<<                         |
begin
    // Entrada principal conservada sin alterar el estado de inicializacion.
    asm("
demo_restart_entry:
    ");
    PreventIRQ();

    // 0=primer arranque, 2=N (sin test), 3=S (repetir test).
    // Despues de S, usar 2: NO aplicar de nuevo el parche SID2 ni D418.
    if startup_intro_done <> 2 then begin
        // Entrada exclusiva S: salta la DECISION, no el test.
        // Con IRQ desactivadas y pila vacia desde ReiniciarDemoDesdeOutro.
        asm("
demo_sysinfo_force_entry:
        ");
        MostrarPantallaDeteccion();
        if startup_intro_done = 3 then begin
            startup_intro_done := 2;
        end
        else begin
            startup_intro_done := 1;
        end;
    end;

    // RESET REAL DE ESTADO EN EL ARRANQUE
    next_line := 42;
    fine_scroll := 7;
    direction := 1;
    scroll_coarse_event := 0;
    escape_requested := 0;
    demo_palette_request := 0;
    demo_palette_latch_lo := 0;
    demo_palette_latch_hi := 0;
    anim_combo_black_period := 1;
    n_izq := 0;
    n_der := 4;
    n_arriba := 0;
    n_abajo := 0;
    blink_global_speed := 3;
    blink_global_black := 1;
    color_mode := 2;
    linear_subdivision := 7;
    linear_mirror := 0;
    linear_row := 0;
    cross_subdivision := 1;
    cross_row_period := 2;
    cross_mirror := 0;
    vertical_subdivision := 3;
    vertical_mirror := 0;
    vertical_scroll_enabled := 1;
    vertical_scroll_speed := 4;
    vertical_scroll_motion := 0;
    vertical_scroll_offset := 0;
    vertical_scroll_counter := 0;
    radial_subdivision := 2;
    radial_direction := 0;
    radial_scroll_enabled := 1;
    radial_scroll_speed := 2;
    radial_anchor_motion_direction := 0;
    radial_anchor_motion_period := 2;
    // STAGE 5
    stage5_scroll_phase := 0;
    // STAGE 13
    stage13_static_active := 0;
    stage13_ghost_next_line := 116;
    stage13_ghost_fine_scroll := 7;
    stage13_consumed_update := 0;
    SetMemoryConfig(1,@useKernal,0);
    DisableCIAInterrupts();
    vic_border := BLACK;
    vic_fondo := BLACK;
    screen_active := 0;
    screen_d018_real := $18;
    screen_d018_mask := $1A;
    vic_d018 := screen_d018_real;
    vic_d016 := $C8;
    vic_d011 := $10 + fine_scroll;
    RenderizarBinarios();
    InicializarMascaraSuperior();
    top_mask_phase := 0;
    PrepararBufferArriba();
    asm("
        ; ---------------------------------------------------------
        ; FIX46: live write-through mirror.
        ; No SID2 -> no patch: VICIOS remains original.
        ; SID2 -> every real D400-D417 store goes to both chips immediately.
        ; ---------------------------------------------------------
        lda startup_intro_done
        cmp #$02               ; segundo pase: musica YA parcheada
        beq fix46_no_stereo_setup
        lda hardware_profile
        beq fix46_no_stereo_setup
        jsr $CE60
fix46_no_stereo_setup:

        ; ---------------------------------------------------------
        ; FIX40: patch VICIOS STA $D418 writes to shadow $33F0.
        ; This prevents the player from fighting the fade envelope.
        ; Music area is $8C00-$A0FF; fixed radial data begins $A100.
        ; NO escanear otra vez el player ya reescrito al volver con N.
        ; ---------------------------------------------------------
        lda startup_intro_done
        cmp #$02
        beq fix40_patch_skip
        lda $FB
        pha
        lda $FC
        pha

        lda #$00
        sta $FB
        lda #$8C
        sta $FC

fix40_patch_d418_loop:
        lda $FC
        cmp #$A1
        beq fix40_patch_d418_done

        ldy #$00
        lda ($FB),y
        cmp #$8D              ; STA absolute
        bne fix40_patch_d418_next
        iny
        lda ($FB),y
        cmp #$18
        bne fix40_patch_d418_next
        iny
        lda ($FB),y
        cmp #$D4
        bne fix40_patch_d418_next

        ; STA $D418 -> STA $33F0
        dey
        lda #$F0
        sta ($FB),y
        iny
        lda #$33
        sta ($FB),y

fix40_patch_d418_next:
        inc $FB
        bne fix40_patch_d418_loop
        inc $FC
        jmp fix40_patch_d418_loop

fix40_patch_d418_done:
        pla
        sta $FC
        pla
        sta $FB
fix40_patch_skip:

        ; Real SID starts completely silent.
        lda #$00
        sta $D418
        pha
        lda hardware_profile
        beq fix46_zero_done
        pla
        jsr $CEE2
        jmp fix46_zero_after
fix46_zero_done:
        pla
fix46_zero_after:
        sta $33F0

        ; INIT now writes its desired D418 value to the shadow.
        lda #$00
        jsr $8FFE

        ; Fade ceiling and divider start at zero.
        lda #$00
        sta startup_intro_fps
        sta startup_intro_frame_counter
        sta startup_intro_seconds
    ");
    if sid_speed_mode < 1 then begin
        sid_speed_mode := 1;
    end;
    if sid_speed_mode > 10 then begin
        sid_speed_mode := 10;
    end;
    sid_rate := sid_speed_table[sid_speed_mode - 1];
    if sid_ramp_target_rate < 1 then begin
        sid_ramp_target_rate := 1;
    end;
    if sid_ramp_target_rate > 50 then begin
        sid_ramp_target_rate := 50;
    end;
    if sid_gradient < 1 then begin
        sid_gradient := 1;
    end;
    if sid_gradient > 10 then begin
        sid_gradient := 10;
    end;
    sid_gradient_blocks := sid_gradient_table[sid_gradient - 1];
    if scroll_speed_manual < 1 then begin
        scroll_speed_manual := 1;
    end;
    if scroll_speed_slow < 1 then begin
        scroll_speed_slow := 1;
    end;
    if scroll_speed_mid1 < 1 then begin
        scroll_speed_mid1 := 1;
    end;
    if scroll_speed_mid2 < 1 then begin
        scroll_speed_mid2 := 1;
    end;
    if scroll_speed_fast < 1 then begin
        scroll_speed_fast := 1;
    end;
    if sid_start_on_first_content = 1 then begin
        sid_ramp_active := 0;
    end
    else begin
        sid_ramp_active := sid_ramp_enabled;
    end;
    sid_first_content_triggered := 0;
    if scroll_sid_link = 0 then begin
        scroll_speed := scroll_speed_manual;
    end
    else begin
        if sid_rate >= scroll_rate_fast then begin
            scroll_speed := scroll_speed_fast;
        end
        else begin
            if sid_rate >= scroll_rate_mid2 then begin
                scroll_speed := scroll_speed_mid2;
            end
            else begin
                if sid_rate >= scroll_rate_mid1 then begin
                    scroll_speed := scroll_speed_mid1;
                end
                else begin
                    scroll_speed := scroll_speed_slow;
                end;
            end;
        end;
    end;
    scroll_phase := 0;
    // Reset independent visual-only fractions; SID IRQ/music remains untouched.
    drean_visual_phase := 0;
    ntsc_visual_phase := 0;
    scroll_update_now := 0;
    if scroll_sid_link = 1 then begin
        if sid_rate >= scroll_rate_fast then begin
            scroll_fullspeed := 1;
        end
        else begin
            scroll_fullspeed := 0;
            if sid_rate >= scroll_rate_mid2 then begin
                map_idx := sid_rate - scroll_rate_mid2;
                if map_idx > 9 then begin
                    map_idx := 9;
                end;
                scroll_phase_step := scroll_smooth_table[map_idx];
            end
            else begin
                scroll_phase_step := 128;
            end;
        end;
    end
    else begin
        scroll_fullspeed := 0;
        scroll_phase_step := 128;
    end;
    scroll_turbo_base_extra := 0;
    scroll_turbo_frac_step := 0;
    scroll_turbo_phase := 0;
    scroll_step_effective := scroll_step;
    scroll_turbo_active := 0;
    scroll_turbo_stage := 0;
    scroll_turbo_stage_counter := 0;
    if scroll_turbo_max_step < scroll_step then begin
        scroll_turbo_max_step := scroll_step;
    end;
    if scroll_turbo_max_step > 7 then begin
        scroll_turbo_max_step := 7;
    end;
    if scroll_turbo_final_seconds < 1 then begin
        scroll_turbo_final_seconds := 1;
    end;
    if scroll_turbo_final_seconds > 50 then begin
        scroll_turbo_final_seconds := 50;
    end;
    sid_accum := 0;

    // Reiniciar fase del reloj multisistema.
    if detected_machine < 3 then begin
        demo_logic_tick := 0;
    end
    else begin
        demo_logic_tick := 1;
    end;
    demo_visual_do_tick := 0;

    if detected_machine = 1 then begin
        // 45 - 37 = 8: fuerza tick en el primer frame.
        demo_tick_accum := 8;
    end
    else begin
        if detected_machine = 2 then begin
            // 37 - 31 = 6: fuerza tick en el primer frame.
            demo_tick_accum := 6;
        end
        else begin
            demo_tick_accum := 0;
        end;
    end;

    sid_ramp_frame_counter := 0;
    sid_ramp_block_counter := 0;
    speed_counter := 0;
    blink_global_counter := 0;
    blink_global_phase := 0;
    vertical_scroll_direction := vertical_scroll_start_direction;
    show_stage := 0;
    flat_color := $01;
    radial_anchor := 0;
    radial_phase := 0;
    radial_scroll_counter := 0;
    radial_update_active := 0;
    radial_slice := 0;
    rotating_lines_counter := 0;
    rotating_lines_step := 0;
    rotating_lines_direction := 0;
    rotating_speed_current := rotating_lines_speed;
    rotating_move_enabled := 0;
    rotating_move_offset := 0;
    rotating_move_direction := 0;
    rotating_scroll_phase := 0;
    final23_scroll_phase := 0;
    final24_scroll_phase := 0;
    final25_scroll_phase := 0;
    rotating_bin_rows_left := 0;
    rotating_bin_mirror := 0;
    radial_anchor_motion_index := 0;
    radial_anchor_motion_counter := 0;
    radial_anchor_motion_enabled := 0;
    anim_sequence_started := 0;
    anim_active := 0;
    anim_start_pending := 0;
    anim_start_delay_counter := 0;
    anim_combo_stage := 0;
    anim_combo_period_counter := 0;
    anim_counter := 0;
    anim_active := 0;
    // RESET DEL FINAL AUTOMATICO
    sid_play_count_lo := 0;
    sid_play_count_hi := 0;
    sid_end_state := 0;
    sid_tail_counter := 0;
    demo_finished := 0;
    basic_return_counter := 0;
    scroll_end_armed := 0;
    final_center_hold_active := 0;
    if sid_tail_frames < 1 then begin
        sid_tail_frames := 1;
    end;
    scroll_end_trigger_lo := sid_end_play_lo;
    scroll_end_trigger_hi := sid_end_play_hi;
    asm("
        lda scroll_end_trigger_lo
        sec
        sbc scroll_end_advance_lo
        sta scroll_end_trigger_lo
        lda scroll_end_trigger_hi
        sbc scroll_end_advance_hi
        sta scroll_end_trigger_hi
    ");

    scroll_turbo_trigger_lo := scroll_end_trigger_lo;
    scroll_turbo_trigger_hi := scroll_end_trigger_hi;
    scroll_turbo_lead_lo := 0;
    scroll_turbo_lead_hi := 0;
    scroll_turbo_stage_plays := 0;
    asm("
        ldx scroll_turbo_final_seconds
turbo_time_calc_loop:
        clc
        lda scroll_turbo_lead_lo
        adc #50
        sta scroll_turbo_lead_lo
        lda scroll_turbo_lead_hi
        adc #0
        sta scroll_turbo_lead_hi
        clc
        lda scroll_turbo_stage_plays
        adc #5
        sta scroll_turbo_stage_plays
        dex
        bne turbo_time_calc_loop
        lda scroll_turbo_trigger_lo
        sec
        sbc scroll_turbo_lead_lo
        sta scroll_turbo_trigger_lo
        lda scroll_turbo_trigger_hi
        sbc scroll_turbo_lead_hi
        sta scroll_turbo_trigger_hi
    ");
    RasterIRQ(SidRasterIRQ(),0,@useKernal);
    EnableIRQ();
    EnableRasterIRQ();
    // | >>> LOOP PRINCIPAL                                                          |
    while true do begin
        WaitVBlank();
        // ESC emulador / RUN-STOP C64: salida inmediata a BASIC.
        ChequearEscape();
        // Teclas 0..9: ChequearEscape solo registra el pedido; ya no
        // ejecutamos el cambio antes de actualizar la animacion.

        // FIX18:
        // PAL-B / PAL-N ejecutan siempre, igual que el master.
        // NTSC consume COMO MAXIMO un tick visual por frame fisico.
        // Los frames extra de 60 Hz sirven para vaciar backlog sin tearing.
        demo_visual_do_tick := 1;

        if detected_machine < 3 then begin
            demo_visual_do_tick := 0;
            if demo_logic_tick > 0 then begin
                dec(demo_logic_tick);
                demo_visual_do_tick := 1;
            end;
        end;
        // OUTRO ONLY: its loader disables the music/raster IRQ, so NTSC's
        // SID-driven tick queue no longer advances. Use WaitVBlank here.
        if basic_return_counter = 255 then begin
            demo_visual_do_tick := 1;
        end;

        if demo_visual_do_tick = 1 then begin

        if sid_end_enabled = 1 then begin
            if scroll_end_armed = 0 then begin
                if sid_play_count_hi > scroll_end_trigger_hi then begin
                    scroll_end_armed := 1;
                end
                else begin
                    if sid_play_count_hi = scroll_end_trigger_hi then begin
                        if sid_play_count_lo >= scroll_end_trigger_lo then begin
                            scroll_end_armed := 1;
                        end;
                    end;
                end;
            end;
        end;
        // Only NTSC: an armed time trigger must NOT truncate a visual stage.
        // Last ascending pass from below is stage 24 (0-based stages 0..25).
        // At stage 23's bottom boundary allow the transition to stage 24;
        // re-arm during stage 24 so the original top-boundary exit completes it.
        // The IRQ also leaves demo_finished clear for NTSC when SID PLAY ends.
        if detected_machine < 3 then begin
            if show_stage < 24 then begin
                scroll_end_armed := 0;
            end;
        end;
        if demo_finished = 1 then begin
            // OUTRO STAGE 1: preserve the approved ~1 s black pause.
            // $FF is a one-time latch; never re-black the loaded artwork.
            // Regular main loop continues to poll RUN/STOP above.
            if basic_return_counter <> 255 then begin
                vic_border := BLACK;
                vic_fondo := BLACK;
                vic_d011 := $07;
                if basic_return_counter < basic_return_delay_frames then begin
                    inc(basic_return_counter);
                end
                else begin
                    FinalizarDemoEnBasic();
                    InicializarOutroMar();
                    basic_return_counter := 255;
                end;
            end
            else begin
                ActualizarOutroMar();
            end;
        end
        else begin
            scroll_coarse_event := 0;
            scroll_update_now := 0;
            if scroll_sid_link = 1 then begin
                if scroll_fullspeed = 1 then begin
                    scroll_update_now := 1;
                end
                else begin
                    asm("
                        lda scroll_phase
                        clc
                        adc scroll_phase_step
                        sta scroll_phase
                        bcc scroll_phase_no_carry
                        lda #1
                        sta scroll_update_now
                        jmp scroll_phase_done
scroll_phase_no_carry:
                        lda #0
                        sta scroll_update_now
scroll_phase_done:
                    ");
                end;
            end
            else begin
                inc(speed_counter);
                if speed_counter >= scroll_speed then begin
                    speed_counter := 0;
                    scroll_update_now := 1;
                end;
            end;
            // NTSC stages 23/24 and Drean stages 23/24 update every visual tick.
            // Drean-only diagnostic: also update stage 25 each tick at speed 4.
            // PAL-B and NTSC stage 25 keep their original cadence.
            if detected_machine <> 3 then begin
                if show_stage >= 23 then begin
                    if show_stage <= 24 then begin
                        scroll_update_now := 1;
                    end;
                end;
            end;
            if detected_machine = 4 then begin
                if show_stage = 25 then begin
                    scroll_update_now := 1;
                end;
            end;
            if scroll_update_now = 1 then begin
                scroll_step_effective := scroll_step + scroll_turbo_base_extra;
                // STAGE 5 / DEGRADE HORIZONTAL UNICO / RETRASO MINIMO
                if show_stage = 5 then begin
                    if stage5_scroll_phase = 3 then begin
                        scroll_step_effective := 1;
                        stage5_scroll_phase := 0;
                    end
                    else begin
                        scroll_step_effective := 2;
                        inc(stage5_scroll_phase);
                    end;
                end;
                // STAGE 12: scroll fraccionario ligeramente acelerado, sin mover inicio.
                // Stage 11 INTACTA: 2,2,1,2,2,1,2,1.
                // Stage 12:        2,2,2,2,2,1,2,1 (+1 pixel cada 8 updates).
                // Mismo contador 0..7, asm compacto para no crecer MAIN.
                asm("
                    pha
                    txa
                    pha
                    tya
                    pha
                    jsr $EFE8
                    lda show_stage
                    cmp #11
                    bcc s12_speed_done
                    cmp #13
                    bcs s12_speed_done
                    ldx rotating_scroll_phase
                    // NTSC OLD/NORMAL (models 1/2): constant 2-pixel rotating steps.
                    // PAL-B and Drean keep their original slow phases 4 and 7.
                    lda detected_machine
                    cmp #3
                    bcc s12_speed_fast
                    cpx #4
                    beq s12_speed_slow
                    cpx #7
                    beq s12_speed_slow
s12_speed_fast:
                    lda #2
                    jmp s12_phase_advance
s12_speed_slow:
                    lda #1
s12_phase_advance:
                    inx
                    cpx #8
                    bne s12_phase_store
                    ldx #0
s12_phase_store:
                    stx rotating_scroll_phase
                    sta scroll_step_effective
s12_speed_done:
                    pla
                    tay
                    pla
                    tax
                    pla
                ");
                if show_stage = 23 then begin
                    if final23_scroll_phase = 0 then begin
                        scroll_step_effective := 2;
                        final23_scroll_phase := 1;
                    end
                    else begin
                        scroll_step_effective := final_circular_fast_step;
                        inc(final23_scroll_phase);
                        if final23_scroll_phase > 2 then begin
                            final23_scroll_phase := 0;
                        end;
                    end;
                end;
                if show_stage = 24 then begin
                    scroll_step_effective := final_circular_fast_step;
                end;
                if show_stage = 25 then begin
                    // FIX21: PAL-B / PAL-N conservan step 3 original.
                    // NTSC recupera solo en la ultima escena alternando 3/4,
                    // promedio 3.5 pixels por tick visual.
                    if detected_machine < 3 then begin
                        if final25_scroll_phase = 0 then begin
                            scroll_step_effective := final_circular_fast_step;
                            final25_scroll_phase := 1;
                        end
                        else begin
                            scroll_step_effective := final_circular_fast_step + 1;
                            final25_scroll_phase := 0;
                        end;
                    end
                    else begin
                        scroll_step_effective := final_circular_fast_step;
                    end;
                end;
                if scroll_sid_link = 1 then begin
                    if scroll_turbo_enabled = 1 then begin
                        if scroll_turbo_frac_step > 0 then begin
                            asm("
                                lda scroll_turbo_phase
                                clc
                                adc scroll_turbo_frac_step
                                sta scroll_turbo_phase
                                bcc scroll_turbo_no_extra_pixel
                                inc scroll_step_effective
scroll_turbo_no_extra_pixel:
                            ");
                        end;
                    end;
                end;
                if scroll_step_effective > scroll_turbo_max_step then begin
                    scroll_step_effective := scroll_turbo_max_step;
                end;
                if scroll_step_effective < 1 then begin
                    scroll_step_effective := 1;
                end;
                // NTSC OLD and NORMAL (models 1/2): visual correction -5% (one pixel per 20 source pixels).
                // Same code for both NTSC systems. Their 37/45 and 31/37 tick clocks stay independent.
                // Machine detection yields 1..4 before demo scroll runs; machine 0 never reaches this routine.
                // Two NOP bytes retain MAIN layout; stage 23/24 late override remains unchanged.
                asm("
                    lda detected_machine
                    cmp #$03
                    bcs ntsc_visual_minus_done
                    nop
                    nop
                    lda ntsc_visual_phase
                    clc
                    adc scroll_step_effective
                    cmp #20
                    bcc ntsc_visual_minus_store
                    sbc #20
                    dec scroll_step_effective
ntsc_visual_minus_store:
                    sta ntsc_visual_phase
ntsc_visual_minus_done:
                ");
                // DREAN VISUAL-ONLY TEST: -1 pixel / 200 BASE pixels (-0.5%).
                // SID IRQ, play count, music pitch, original speed ramps UNCHANGED.
                // Accumulate AFTER existing stage/turbo calculations; occasionally use 0 pixels.
                // Only PHYSICAL PAL-N (marker $8BBF=4). Aliased PAL-B (marker=3) skips this.
                asm("
                    lda $8BBF
                    cmp #$04
                    bne drean_visual_bonus_done
                    lda drean_visual_phase
                    clc
                    adc scroll_step_effective
                    cmp #200
                    bcc drean_visual_bonus_store
                    sbc #200
                    dec scroll_step_effective
drean_visual_bonus_store:
                    sta drean_visual_phase
drean_visual_bonus_done:
                ");
                // NTSC stages 23/24: approved trial at 5 pixels per update.
                if detected_machine < 3 then begin
                    if show_stage >= 23 then begin
                        if show_stage <= 24 then begin
                            scroll_step_effective := 5;
                        end;
                    end;
                end;
                // Drean PAL-N ONLY: test stages 23/24/25 at 4 pixels per visual tick.
                // Stage 25 is the additional downward scene with static characters.
                // PAL-B and NTSC stay unchanged.
                if detected_machine = 4 then begin
                    if show_stage >= 23 then begin
                        if show_stage <= 25 then begin
                            scroll_step_effective := 4;
                        end;
                    end;
                end;
                // STAGE 13 / SCROLL FANTASMA
                stage13_consumed_update := 0;
                // PRUEBA GLOBAL +2%: solo JSR (3 bytes) en MAIN; motor en $8B10.
                // Despues de overrides 23-25, antes de consumir paso y cambiar raster.
                asm("
                    jsr $FFC8
                ");
                if show_stage = 13 then begin
                    if stage13_static_active = 1 then begin
                        stage13_consumed_update := 1;
                        stage13_ghost_fine_scroll := stage13_ghost_fine_scroll + scroll_step_effective;
                        if stage13_ghost_fine_scroll >= 8 then begin
                            stage13_ghost_fine_scroll := stage13_ghost_fine_scroll - 8;
                            if stage13_ghost_next_line <= limit_down then begin
                                // Ultimo blink del Stage 13 = NEGRO.
                                blink_global_phase := 8;
                                blink_global_counter := 0;
                                AplicarBlinkGlobal();
                                SalirStage13Centro();
                            end
                            else begin
                                dec(stage13_ghost_next_line);
                            end;
                        end;
                    end;
                end;
                if stage13_consumed_update = 0 then begin
                if direction = 1 then begin
                    if fine_scroll < scroll_step_effective then begin
                        fine_scroll := (fine_scroll + 8) - scroll_step_effective;
                        vic_d011 := $10 + fine_scroll;
                        if next_line >= limit_up then begin
                            if scroll_end_armed = 1 then begin
                                demo_finished := 1;
                                fine_scroll := 7;
                                vic_d011 := $17;
                            end
                            else begin
                                EventoPantallaNegra();
                                direction := 0;
                                fine_scroll := 7;
                                vic_d011 := $17;
                                PrepararBufferAbajo();
                            end;
                        end
                        else begin
                            DesplazarArriba();
                        end;
                    end
                    else begin
                        fine_scroll := fine_scroll - scroll_step_effective;
                        vic_d011 := $10 + fine_scroll;
                    end;
                end
                else begin
                    fine_scroll := fine_scroll + scroll_step_effective;
                    if fine_scroll >= 8 then begin
                        fine_scroll := fine_scroll - 8;
                        if next_line <= limit_down then begin
                            if scroll_end_armed = 1 then begin
                                demo_finished := 1;
                                fine_scroll := 7;
                                vic_d011 := $17;
                            end
                            else begin
                                EventoPantallaNegra();
                                direction := 1;
                                fine_scroll := 7 - scroll_step_effective;
                                vic_d011 := $10 + fine_scroll;
                                PrepararBufferArriba();
                            end;
                        end
                        else begin
                            vic_d011 := $10 + fine_scroll;
                            DesplazarAbajo();
                        end;
                    end
                    else begin
                        vic_d011 := $10 + fine_scroll;
                    end;
                end;
                end;
            end;
            RevisarFinalCentrado();
            if color_mode = 1 then begin
                ActualizarBlinkStage13Constante();
                ActualizarBlinkGlobal();
            end;
            if color_mode = 6 then begin
                ActualizarScrollDegradeVertical();
            end;
            if color_mode = 7 then begin
                ActualizarDegradeRadial();
            end;
            if color_mode = 8 then begin
                ActualizarLineasRotatorias();
            end;
            ActualizarInicioAnimacionPETSCII();
            inc(anim_counter);
            if anim_active = 1 then begin
                if anim_counter >= anim_speed then begin
                    anim_counter := 0;
                    AnimarCaracterIndependiente();
                end;
            end;
        end;

        end; // FIX18: demo_visual_do_tick

        // Palette worker DESPUES del scroll: 64 bytes maximo por cuadro.
        // Mantener fuera de SYSINFO, pantalla final y OUTRO.
        if demo_finished = 0 then begin
            if basic_return_counter <> 255 then begin
                AlternarPaletasDemo();
            end;
        end;

    end;
end.
