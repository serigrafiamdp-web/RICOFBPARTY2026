    // O oculta: NO usar $4FC0..$4FFF para codigo: RAM TEST ($BC60) los pisa
    // guardando alli los 64 bytes de $4F80..$4FBF, aunque el mapa diga libres.
    // A0C1-A0FD: 61 bytes libres entre el final de music.bin y los mapas A100.
    // El unico array se retiene por la llamada SIMBOLICA desde la DEMO.
    // A0C1-A0DF: probe O en DEMO (flag del prompt o teclado en vivo).
    // A0E0-A0FD: scanner S/O del prompt; el wrapper $1A2E mapea BASIC fuera
    // temporalmente y restaura exactamente el valor previo de $01.
    // OUTRO normal sin cambiar; MAIN no crece; BIN intactos.
    @startblock $A0C1 "TECLA_O_RAM_SEGURA"
    demo_o_outro_probe : array[61] of byte = (
        $AD,$98,$3B,$F0,$0C,$A9,$EF,$8D,$00,$DC,$AD,$01,
        $DC,$29,$40,$D0,$0B,$A9,$40,$8D,$98,$3B,$A9,$01,
        $8D,$BD,$38,$60,$4C,$1E,$81,$A9,$FD,$8D,$00,$DC,
        $AD,$01,$DC,$29,$20,$8D,$97,$3B,$A9,$EF,$8D,$00,
        $DC,$AD,$01,$DC,$29,$40,$8D,$98,$3B,$20,$73,$5A,
        $60
    );
    @endblock

    // PRESS A KEY: scanner incorporado al FUENTE (no depende de BIN nuevo).
    // IMPORTANTE TRSE: usar referencias simbolicas, no JSR/JMP $xxxx numericos: la optimizacion puede omitir arrays no referidos.
    // Wrapper RAM ejecutable siempre: $1A2E-$1A3B (14 bytes).
    // Preserva $01 y pila; LORAM=0 expone $A0E0 bajo BASIC; espera RTS
    // del scanner tras llamar al mismo stop de paleta $5A73 que funcionaba.
    @startblock $1A2E "SYSINFO_PROMPT_S_O_WRAPPER"
    intro_prompt_s_source_scan : array[14] of byte = (
        $A5,$01,$48,$29,$FE,$85,$01,$20,$E0,$A0,$68,$85,$01,$60
    );
    @endblock

    // IEC display-only heart: starts red/pink during probe, settles red at finish.
    // Entry $1A40=start, $1A43=done/restore, $1A46=frame dispatcher.
    // Located after IEC $1900-$1A2D and before existing SID1 vectors at $1BC0.
    @startblock $1A40 "INTRO_IEC_HEART"
    intro_iec_heart : incbin("intro_iec_heart.bin");
    @endblock

    // PRESS A KEY: decision incorporada al FUENTE; $1A94-$1A9E (11 bytes).
    // $3B97=0 significa S: repetir el PROCEDIMIENTO desde $500F.
    // El SYSINFO original fue llamado con JSR $500F desde $76B2:
    // NO reiniciar MAIN ni TXS dentro del procedimiento; preservar la direccion
    // de retorno original en pila. Al finalizar una tecla no-S, RTS en $5A90
    // vuelve al flujo normal tras JSR y la demo comienza como siempre.
    @startblock $1A94 "SYSINFO_PROMPT_S_DESPACHO_EN_FUENTE"
    intro_prompt_s_source_dispatch : array[11] of byte = (
        $AD,$97,$3B, $F0,$03, $4C,$95,$8B, $4C,$0F,$50
    );
    @endblock

    // Cosmetic-only hearts in the unused $1AA0..$1BBF gap; no JOY reads.
    // Entries: hide JOY $1AA0, DUAL start/done $1AA3/$1AA6,
    // JOY start/done $1AA9/$1AAC, frame tick $1AAF, final red $1AB2.
    @startblock $1AA0 "INTRO_FAKE_HEARTS"
    intro_fake_hearts : incbin("intro_fake_hearts.bin");
    @endblock

    // Cosmetic CPU/VIC-CIA/RAM frame tick: no test code or hardware access.
    // Fits exactly in the free $1B68..$1BBF gap after the approved fake hearts.
    @startblock $1B68 "INTRO_BASIC_TESTS_TICK"
    intro_basic_tests_tick : incbin("intro_basic_tests_tick.bin");
    @endblock

    // SID2 frame dispatcher in free intro-data tail; $39D2-$39F9.
    // If not SID2, tail-jump to exact old $1E06 heartbeat tick.
    // Sea helper still begins unmodified at $3A00.
    @startblock $39D2 "INTRO_SID2_HEART_TICK"
    intro_sid2_heart_tick : incbin("intro_sid2_heart_tick.bin");
    @endblock

    @startblock $3A00 "SEA_WAVES_HELPER"
    sea_waves_helper : incbin("sea_waves.bin");
    @endblock

    // Intro charset animation: separate helper in unused gap before radial maps.
    @startblock $3ABC "INTRO_CHARSET_ANIM"
    intro_charset_anim : incbin("intro_charset_anim.bin");
    @endblock

    // COSMETIC ONLY: hide SID1/SID2 address until each actual test finishes.
    // FIX S: $3B47..$3B89 = executable SID-address helper; $3B8A..$3B95 = prompt.
    // $3B96 is reserved for the intro_pixel_scroll direction byte (formerly $3B47).
    // $3B97 se reserva para S en PRESS A KEY; $3B98..$3B9D libres.
    // $3B9E..$3BA0 = sea-animation state.
    // remain reserved for the unchanged sea animation state. No SID writes here.
    @startblock $3B47 "INTRO_SID_ADDRESS_HIDE"
    intro_sid_addresses_a : incbin("intro_sid_addresses_a.bin");
    @endblock

    // Restore the author's row 22 in original PETSCII after first sea frame.
    // $3B8A-$3B95; sea-only state $3B9E-$3BA0 left strictly unchanged.
    @startblock $3B8A "INTRO_PROMPT_REVEAL_AFTER_SEA"
    intro_prompt_reveal : incbin("intro_prompt_reveal.bin");
    @endblock
    @startblock $3BA1 "INTRO_SID_ADDRESS_REVEAL"
    intro_sid_addresses_b : incbin("intro_sid_addresses_b.bin");
    @endblock

    @startblock $CE60 "LIVE_DUAL_SID_HELPER"
    stereo_helper : incbin("stereo.bin");
    @endblock

    // OrgAsm FIX: 22 free bytes immediately after the UNCHANGED stereo.bin.
    // Entry $CFEA = original JOY hide + basic hide;
    //       $CFF1 = original final-heart restore + basic result restore;
    //       $CFF8 = start VIC/CIA cosmetics.
    // Keeps MAIN below music at $8C00; no changes to SID or tests.
    @startblock $CFEA "INTRO_BASIC_TESTS_BRIDGE"
    intro_basic_tests_bridge : incbin("intro_basic_tests_bridge.bin");
    @endblock


    @startblock $C000 "RICOS_UI"
    ui_helper : incbin("ui.bin");
    @endblock

    // SID1 preserves its approved model animation. SID2 & DUAL MODE: visual-only.
    // Starts at the byte immediately AFTER current 939-byte ui.bin ($C3AB).
    // Entrypoints: init=$C3AB, found=$C3C9, render=$C3DD.
    // No CIA/SID writes, no joystick code, no changes to detection or demo engine.
    @startblock $C3AB "SID2_VISUAL_SAFE"
    sid2_visual : incbin("sid2_visual_safe.bin");
    @endblock

    // Visual-only hooks for the already tested CPU, VIC/CIA and RAM diagnostics.
    // $C450..$C4FF: free immediately after the approved SID2 visual ($C44F).
    // Never overlap CHAR data at $C500.
    @startblock $C450 "INTRO_BASIC_TESTS_VISUAL"
    intro_basic_tests_visual : incbin("intro_basic_tests_visual.bin");
    @endblock

    // RAM DATA R/W, RAM ADDRESS, COLOR RAM, STACK PUSH/POP + charset visual sample.
    // No changes to sea sound, SID tests, or visual demo.
    // $BC60..$BFFF was unallocated in the user's TRSE memory map.
    @startblock $BC60 "INTRO_RAM_TESTS"
    intro_ram_tests : incbin("intro_diagnostics_charset_bankfix.bin");
    @endblock

    // Only RAM-test pause/scroll JSR targets change: all test instructions preserved.
    // Under BASIC ROM, this helper is called only while LORAM is disabled.
    @startblock $BFC0 "INTRO_BASIC_TESTS_WRAPPERS"
    intro_basic_tests_wrappers : incbin("intro_basic_tests_wrappers.bin");
    @endblock

    // Three flags occupy the existing unused $1FFA..$1FFC gap.
    @startblock $1FFA "INTRO_BASIC_TEST_FLAGS"
    intro_basic_test_flags : array[3] of byte = (0,0,0);
    @endblock

    // PAL-B-only cadence test: under-KERNAL RAM after approved outro binary.
    // $FFC8..$FFF9 free in static map; vectors $FFFA..$FFFF untouched.
    // Unlike $4F70, this area is not RAM-test scratch.
    @startblock $FFC8 "PALB_UNIFORM_CADENCE_AFTER_OUTRO"
    palb_uniform_cadence : incbin("palb_uniform_cadence_safe.bin");
    @endblock

@startblock $5000 "MAIN"
    vic_sprites : BYTE at $D015;
    vic_d011 : BYTE at $D011;
    vic_d016 : BYTE at $D016;
    vic_d018 : BYTE at $D018;
    vic_border : BYTE at $D020;
    vic_fondo : BYTE at $D021;
    // |                         >>> FINE TUNING <<<                                |
    // Stages 11/12 comparten la misma velocidad rotatoria.
    // STAGE 13 / PETSCII CENTRADO + BLINK CONSTANTE RAPIDO
    // |                       <<< FIN FINE TUNING >>>                              |
    // CONFIGURACION INTERNA FIJA DE ESTA DEMO
    // DIRECCIONES INDEPENDIENTES DE LOS 4 CHARS PETSCII
    // BACKUP DE LOS 4 CHARS ORIGINALES.
    // TABLA DE VELOCIDADES SID
    // TABLA DE GRADIENTES
    // TABLA INTERNA DE SUAVIZADO DEL SCROLL
    // VARIABLES INTERNAS DEL FINAL AUTOMATICO
    // RETORNO AUTOMATICO A BASIC DESPUES DEL NEGRO FINAL.
    // ESC en emulador / RUN-STOP en C64 real.
    // DETECCION DE MAQUINA / INTRO DE ARRANQUE
    // 1 = NTSC OLD, 2 = NTSC, 3 = PAL-B, 4 = DREAN PAL-N
    // PERFIL INFORMATIVO REAL / EMULADOR.
    // 1 = REAL-LIKE, 2 = EMULATED-LIKE.
    // Es heuristico: NO afecta el funcionamiento de la demo.
    // Mensajes de la terminal movidos a INTRO_DATA $3400 para no crecer MAIN.

    // RELOJ LOGICO MULTISISTEMA
    // PAL-B / PAL-N: 1 tick por frame.
    // NTSC old: 37 ticks / 45 frames.
    // NTSC new: 31 ticks / 37 frames.
    // Este tick gobierna SID y logica visual juntos.
    // FIX18: flag local del loop para ejecutar como maximo UN tick visual por VBlank.
    // STAGE 5 / TRANSICION HORIZONTAL UNICA:
    // Movimiento espacial SOLO para Stage 13.
    // Fase de scroll para stages 11/12:
    // STAGE 5 / DEGRADE HORIZONTAL UNICO
    // STAGE 13 / BLINK GLOBAL + PETSCII FIJO
procedure WaitVBlank();
begin
    asm("
wait_hit:
        lda $D012
        cmp #251
        bne wait_hit
wait_leave:
        lda $D012
        cmp #251
        beq wait_leave
    ");
end;

procedure MostrarPantallaDeteccion();
begin
    detected_machine := 0;
    startup_intro_fps := 50;

    // FIX22: deteccion robusta de VIC por ciclos de UN FRAME completo.
    // Timer B CIA1:
    // resultado bruto 0 = PAL-B
    // resultado bruto 1 = NTSC OLD
    // resultado bruto 2 = NTSC
    // resultado bruto 3 = DREAN PAL-N
    //
    // Luego lo convertimos a nuestra codificacion:
    // 1 = NTSC OLD, 2 = NTSC, 3 = PAL-B, 4 = DREAN PAL-N.
    asm("
        sei

        ; Pantalla apagada y negra durante la medicion.
        lda #$0B
        sta $D011
        lda #$00
        sta $D020
        sta $D021

        ; CIA1 Timer B = $FFFF.
        lda #$FF
        sta $DC06
        sta $DC07

        ; Esperar comienzo exacto de un frame:
        ; primero entrar en raster >255, luego volver a raster 0.
intro_detect_wait_hi_1:
        bit $D011
        bpl intro_detect_wait_hi_1
intro_detect_wait_zero_1:
        bit $D011
        bmi intro_detect_wait_zero_1

        ; Arrancar Timer B contando ciclos de CPU.
        lda #%00011001
        sta $DC0F

        ; Esperar exactamente el siguiente comienzo de frame.
intro_detect_wait_hi_2:
        bit $D011
        bpl intro_detect_wait_hi_2
intro_detect_wait_zero_2:
        bit $D011
        bmi intro_detect_wait_zero_2

        ; A sigue conteniendo $19, por eso recargar $FF.
        ; Diferencia del high-byte del timer:
        ; PAL-B  -> $4C -> bits bajos 00
        ; NTSC1  -> $41 -> bits bajos 01
        ; NTSC2  -> $42 -> bits bajos 10
        ; PAL-N  -> $4F -> bits bajos 11
        lda #$FF
        sec
        sbc $DC07
        and #$03
        tay

        ; Detener Timer B: ya termino la medicion.
        lda #$00
        sta $DC0F

        ; Traducir resultado bruto:
        ; 0 PAL-B -> 3
        ; 1 NTSC OLD -> 1
        ; 2 NTSC -> 2
        ; 3 DREAN -> 4
        tya
        cmp #$00
        beq intro_detect_tww_pal
        cmp #$03
        beq intro_detect_tww_drean

        ; 1 y 2 coinciden con nuestra codificacion.
        sta detected_machine
        jmp intro_detect_tww_done

intro_detect_tww_pal:
        lda #$03
        sta detected_machine
        jmp intro_detect_tww_done

intro_detect_tww_drean:
        lda #$04
        sta detected_machine

intro_detect_tww_done:
    ");

    // NTSC = ~60 fps. PAL-B y DREAN PAL-N = ~50 fps.
    if detected_machine < 3 then begin
        startup_intro_fps := 60;
    end
    else begin
        startup_intro_fps := 50;
    end;

    // VIC bank 0, Screen $0400, charset ROM $1000.
    asm("
        lda $DD00
        ora #$03
        sta $DD00

        lda #$14
        sta $D018
        lda #$C8
        sta $D016
        lda #$1B
        sta $D011
        lda #$00
        sta $D020
        sta $D021

        ; Limpiar pantalla completa a espacios.
        lda #$20
        ldx #$00
intro_clear_screen_0:
        sta $0400,x
        sta $0500,x
        sta $0600,x
        inx
        bne intro_clear_screen_0

        ldx #$00
intro_clear_screen_tail:
        sta $0700,x
        inx
        cpx #$E8
        bne intro_clear_screen_tail

        ; Color base blanco.
        lda #$01
        ldx #$00
intro_clear_color_0:
        sta $D800,x
        sta $D900,x
        sta $DA00,x
        inx
        bne intro_clear_color_0

        ldx #$00
intro_clear_color_tail:
        sta $DB00,x
        inx
        cpx #$E8
        bne intro_clear_color_tail

        ; FIX36 diagnostic result scratch:
        ; startup_intro_seconds = SID LFSR functional flag (1/0).
        lda #$00
        sta startup_intro_seconds
        sta startup_intro_fps
        jsr $1C56  ; Show fixed user artwork before ANY diagnostics.
        lda detected_machine
        jsr $1D00  ; Patch ONLY machine row 6 in both art screens and color buffers.
        jsr $1E09  ; Hide existing LFSR and ENV3 results in visible artwork.
        jsr $1BC0  ; SID1: hide 6581-LIKE model text until real classification.
        jsr $C3AB  ; SID2 model hidden; fixed artwork DUAL SID MODE starts MONO.
        jsr $CFEA  ; Same original JOY hide + CPU/VIC/RAM OK hide, in bridge.
        jsr $18C7  ; Pending test hearts black. MACHINE is already tested/red.
        jsr $3B47  ; Conceal ONLY the two 5-character SID address fields.
        jsr $18F2  ; Hide full PRESS A KEY row 22 while all diagnostics run.
    ");

    // FIX29B: viejo detector REAL/EMU retirado.

    // Terminal tipo DOS: escribir caracter por caracter en la ultima fila
    // y subir una fila completa entre pruebas.
    asm("
        ; FIX34: evidence-driven diagnostic agent.
        ldx #$00
intro_agent_hello_print:
        lda intro_msg_agent_hello,x
        beq intro_agent_hello_done
        sta $07C1,x
        jsr intro_term_wait_frame
        inx
        bne intro_agent_hello_print
intro_agent_hello_done:
        jsr intro_term_pause
        jsr intro_term_scroll

        ; VIC-II / MACHINE TIMING
intro_type_vic_select:
        lda detected_machine
        cmp #$04
        beq intro_type_vic_drean_start
        cmp #$03
        beq intro_type_vic_pal_start

intro_type_vic_ntsc_start:
        ldx #$00
intro_type_vic_ntsc:
        lda intro_msg_vic_ntsc,x
        beq intro_type_vic_done
        sta $07C1,x
        jsr intro_term_wait_frame
        inx
        bne intro_type_vic_ntsc

intro_type_vic_pal_start:
        ldx #$00
intro_type_vic_pal:
        lda intro_msg_vic_pal,x
        beq intro_type_vic_done
        sta $07C1,x
        jsr intro_term_wait_frame
        inx
        bne intro_type_vic_pal

intro_type_vic_drean_start:
        ldx #$00
intro_type_vic_drean:
        lda intro_msg_vic_drean,x
        beq intro_type_vic_done
        sta $07C1,x
        jsr intro_term_wait_frame
        inx
        bne intro_type_vic_drean

intro_type_vic_done:
        jsr intro_term_pause
        jsr intro_term_scroll
        jsr $CFF8  ; Identical VIC/CIA start instructions, relocated out of MAIN.

        ; VIC and CIA timing share the already measured VIC-frame / CIA1 Timer B result.
        ; Display one combined line; the two OKs are not independent measurements.
        ldx #$00
intro_type_vic_frame:
        lda intro_msg_vic_frame,x
        beq intro_type_vic_frame_done
        sta $07C1,x
        jsr intro_term_wait_frame
        inx
        bne intro_type_vic_frame
intro_type_vic_frame_done:
        jsr intro_term_pause
        jsr $1BB5  ; Identical VIC/CIA result instructions, relocated out of MAIN.
        jsr intro_term_scroll

        ; OSC3/LFSR functional classification remains unchanged.
        ; The redundant CIA stability probe and OSC3 hexadecimal display are omitted.
intro_lfsr_setup:
        jsr $1E00  ; Activate red/pink heart for the REAL LFSR test.
        ; TEST=1 para partir de un estado limpio, luego NOISE.
        lda #$08
        sta $D412
        lda #$FF
        sta $D40E
        sta $D40F
        lda #$80
        sta $D412

        ; Dar tiempo al oscilador/LFSR para arrancar.
        jsr intro_term_wait_frame

        ; Preserve the original 24 frame OSC3 warm-up/sampling time, but do not
        ; draw the hexadecimal sample or consume a screen row.
        ldy #$18
intro_lfsr_warmup_loop:
        lda $D41B
        jsr intro_term_wait_frame
        dey
        bne intro_lfsr_warmup_loop

        ; Perfil de velocidad inspirado en ventanas de OSC3:
        ; tres ventanas consecutivas de 8 lecturas.
        ; Si las 3 dan 7 cambios => FAST.
        ldy #$03
intro_lfsr_fast_windows:
        jsr intro_lfsr_count8
        cmp #$07
        bne intro_lfsr_not_fast
        dey
        bne intro_lfsr_fast_windows

        lda #$01
        sta hardware_profile
        jmp intro_lfsr_classified

intro_lfsr_not_fast:
        ; Esperar unas decenas de ms y confirmar que haya actividad.
        ldy #$03
intro_lfsr_activity_wait:
        jsr intro_term_wait_frame
        dey
        bne intro_lfsr_activity_wait

        jsr intro_lfsr_count8
        cmp #$03
        bcc intro_lfsr_no_activity

        lda #$02
        sta hardware_profile
        jmp intro_lfsr_classified

intro_lfsr_no_activity:
        lda #$03
        sta hardware_profile

intro_lfsr_classified:
        ; Save a simple functional result for final OK/NO marking.
        ; FAST or SLOW = active generator = OK. NO ACTIVITY = NO.
        lda hardware_profile
        cmp #$03
        beq intro_lfsr_store_no
        lda #$01
        bne intro_lfsr_store_flag
intro_lfsr_store_no:
        lda #$00
intro_lfsr_store_flag:
        sta startup_intro_seconds

        ; Stop Voice 3 before printing its functional result on this same row.
        lda #$00
        sta $D412
        sta $D40E
        sta $D40F

        lda hardware_profile
        cmp #$01
        beq intro_type_lfsr_fast_start
        cmp #$02
        beq intro_type_lfsr_slow_start

intro_type_lfsr_no_start:
        ldx #$00
intro_type_lfsr_no:
        lda intro_msg_lfsr_no,x
        beq intro_type_lfsr_result_done
        sta $07C1,x
        jsr intro_term_wait_frame
        inx
        bne intro_type_lfsr_no

intro_type_lfsr_slow_start:
        ldx #$00
intro_type_lfsr_slow:
        lda intro_msg_lfsr_slow,x
        beq intro_type_lfsr_result_done
        sta $07C1,x
        jsr intro_term_wait_frame
        inx
        bne intro_type_lfsr_slow

intro_type_lfsr_fast_start:
        ldx #$00
intro_type_lfsr_fast:
        lda intro_msg_lfsr_fast,x
        beq intro_type_lfsr_result_done
        sta $07C1,x
        jsr intro_term_wait_frame
        inx
        bne intro_type_lfsr_fast

intro_type_lfsr_result_done:
        lda startup_intro_seconds  ; Actual LFSR classification: 1=OK, 0=FAIL.
        jsr $1E03  ; Stop blinking, red heart; reveal real result with art colors.
        jsr intro_term_pause
        jsr intro_term_scroll

        ; SID ENV3 RESPONSE: use the original $C100 test and its real A=0/1 result.
        ; Visual-only hooks: second row's OK is hidden and heart blinks red/pink.
        jsr $1E0F  ; Start ENV3 heart, row 14.
        jsr $C100  ; Unchanged SID ENV3 test (returns A=0 FAIL / 1 OK).
        jsr $1E12  ; Freeze heart red, reveal OK from art or show real FAIL.
        jsr intro_term_pause
        jsr intro_term_scroll

        jmp intro_sid_model_test

        ; Cuenta cambios entre 8 lecturas consecutivas de OSC3.
        ; Devuelve A = 0..7.
intro_lfsr_count8:
        lda $D41B
        sta startup_intro_frame_counter
        lda #$00
        sta startup_intro_second_counter
        ldx #$07
intro_lfsr_count8_loop:
        lda $D41B
        cmp startup_intro_frame_counter
        beq intro_lfsr_count8_same
        inc startup_intro_second_counter
intro_lfsr_count8_same:
        sta startup_intro_frame_counter
        dex
        bne intro_lfsr_count8_loop
        lda startup_intro_second_counter
        rts

        ; ---------------------------------------------------------
        ; FIX29B: SID MODEL compacto.
        ; Test OSC3 de retardo: bit0 diferencia 6581/8580.
        ; ---------------------------------------------------------
intro_sid_model_test:
        jsr $1E18  ; SID1 heart begins red/pink blink; no SID test changed.
intro_sid_model_wait:
        lda $D012
        cmp #$FF
        bne intro_sid_model_wait

        lda #$FF
        sta $D412
        sta $D40E
        sta $D40F
        lda #$20
        sta $D412
        lda $D41B
        lsr
        bcc intro_sid_model_8580

intro_sid_model_6581:
        jsr $1BC9  ; Record existing 6581-LIKE branch, unchanged decision.
        ldx #$00
intro_sid_model_6581_print:
        lda intro_msg_sidmodel_6581,x
        beq intro_sid_model_done
        sta $07C1,x
        jsr intro_term_wait_frame
        inx
        bne intro_sid_model_6581_print

intro_sid_model_8580:
        jsr $1BCC  ; Record existing 8580-LIKE branch, unchanged decision.
        ldx #$00
intro_sid_model_8580_print:
        lda intro_msg_sidmodel_8580,x
        beq intro_sid_model_done
        sta $07C1,x
        jsr intro_term_wait_frame
        inx
        bne intro_sid_model_8580_print

intro_sid_model_done:
        ; FIX37: no short confirmation burst here.
        ; The final dual-SID sea test will keep the noise continuous.
        lda #$00
        sta $D412
        sta $D418
        jsr $1E1B  ; SID1 test finished; heart red, no effect on SID writes.
        jsr $1BC3  ; Reveal the detected model on the fixed art screen.
        jsr $3B5D  ; SID1 test complete: reveal standard $D400 from user's art.
        jsr intro_term_pause
        jsr intro_term_scroll

        ; ---------------------------------------------------------
        ; SECOND SID: DE00 (VICE default), D420 and D500.
        ; $FB/$FC = temporary candidate base pointer.
        ; ---------------------------------------------------------
        jsr $13E8  ; SID2 marker active: blink red/pink while address is probed.
        lda $FB
        pha
        lda $FC
        pha

        ; VICE uses $DE00 as the default second-SID base.
        lda #$00
        sta $FB
        lda #$DE
        sta $FC
        jsr intro_sid2_probe
        bcs intro_sid2_found_de00

        ; Very common internal stereo-SID address.
        lda #$20
        sta $FB
        lda #$D4
        sta $FC
        jsr intro_sid2_probe
        bcs intro_sid2_found_d420

        ; Another common internal stereo-SID address.
        lda #$00
        sta $FB
        lda #$D5
        sta $FC
        jsr intro_sid2_probe
        bcs intro_sid2_found_d500

intro_sid2_not_found:
        lda #$00
        sta startup_intro_second_counter
        jmp intro_sid2_restore

intro_sid2_found_de00:
        lda #$01
        bne intro_sid2_store_found

intro_sid2_found_d420:
        lda #$02
        bne intro_sid2_store_found

intro_sid2_found_d500:
        lda #$03

intro_sid2_store_found:
        sta startup_intro_second_counter
        jsr $C3C9  ; Confirmed SID2: visible MONO -> STEREO immediately.

intro_sid2_restore:
        ; Keep $FB/$FC pointing at the detected candidate.
        ; SID2 address detection is trusted here.
        ; Model classification is deliberately disabled until validated
        ; independently on VICE and real hardware.
        lda startup_intro_second_counter
        beq intro_sid2_no_start
        cmp #$01
        beq intro_sid2_de00_start
        cmp #$02
        beq intro_sid2_d420_start
        jmp intro_sid2_d500_start

intro_sid2_de00_start:
        ldx #$00
intro_sid2_de00_print:
        lda intro_msg_sid2_de00,x
        beq intro_sid2_print_done
        sta $07C1,x
        jsr intro_term_wait_frame
        inx
        bne intro_sid2_de00_print

intro_sid2_d420_start:
        ldx #$00
intro_sid2_d420_print:
        lda intro_msg_sid2_d420,x
        beq intro_sid2_print_done
        sta $07C1,x
        jsr intro_term_wait_frame
        inx
        bne intro_sid2_d420_print

intro_sid2_d500_start:
        ldx #$00
intro_sid2_d500_print:
        lda intro_msg_sid2_d500,x
        beq intro_sid2_print_done
        sta $07C1,x
        jsr intro_term_wait_frame
        inx
        bne intro_sid2_d500_print

intro_sid2_no_start:
        ldx #$00
intro_sid2_no_print:
        lda intro_msg_sid2_no,x
        beq intro_sid2_print_done
        sta $07C1,x
        jsr intro_term_wait_frame
        inx
        bne intro_sid2_no_print

intro_sid2_print_done:
intro_sid2_click_done:
        ; Save SID2 evidence address for final reasoning:
        ; 0 none, 1 DE00, 2 D420, 3 D500.
        lda startup_intro_second_counter
        sta hardware_profile
        lda hardware_profile
        jsr $C3DD  ; SID2 model UNKNOWN/NOT FOUND; mode real.

        ; Restore original temporary zero-page values.
        pla
        sta $FC
        pla
        sta $FB

        lda hardware_profile
        jsr $3BA1  ; SID2 test complete: render real address, or ----- if absent.
        jsr $17E8  ; SID2 completed: stop blink and leave its heart solid red.
        jsr intro_term_pause
        jsr intro_term_scroll

        ; SID REPLACEMENT TYPE - SIDKick-pico exact signature only.
        jsr $C300
        jsr intro_term_pause
        jsr intro_term_scroll

        ; Cosmetic DUAL heart runs for BOTH MONO and STEREO confirmations.
        jsr $1AA3  ; Start the row-16 red/pink heartbeat; no SID logic changed.
        ; Terminal history ON/OFF unchanged; fixed artwork mode is MONO/STEREO.
        lda hardware_profile
        beq intro_dual_mode_off_start

intro_dual_mode_on_start:
        ldx #$00
intro_dual_mode_on_print:
        lda intro_msg_dual_on,x
        beq intro_dual_mode_done
        sta $07C1,x
        jsr intro_term_wait_frame
        inx
        bne intro_dual_mode_on_print

intro_dual_mode_off_start:
        ldx #$00
intro_dual_mode_off_print:
        lda intro_msg_dual_off,x
        beq intro_dual_mode_done
        sta $07C1,x
        jsr intro_term_wait_frame
        inx
        bne intro_dual_mode_off_print

intro_dual_mode_done:
        jsr intro_term_pause
        jsr $1AA6  ; DUAL confirmation finished: heart solid red in either mode.
        ; JOY check remains removed; continue directly to visual-only fake stage.
        jmp intro_post_dual_sid

        ; ---------------------------------------------------------
        ; FIX33: SECOND SID MIRROR + ACTIVITY PROBE
        ; Candidate base is in ($FB/$FC).
        ;
        ; Phase 1:
        ; Run NOISE on SID 1 ($D400), keep candidate silent.
        ; If candidate OSC3 becomes non-zero, candidate is a mirror.
        ;
        ; Phase 2:
        ; Run NOISE on the candidate itself.
        ; Require changing OSC3 values to confirm a real SID-like slot.
        ;
        ; C=1 independent active SID, C=0 mirror/absent.
        ; ---------------------------------------------------------
intro_sid2_probe:
        ; Keep candidate Voice 3 silent.
        lda #$00
        ldy #$12
        sta ($FB),y
        ldy #$0E
        sta ($FB),y
        iny
        sta ($FB),y

        ; Reset SID 1 Voice 3 / LFSR.
        lda #$08
        sta $D412
        lda #$00
        sta $D40E
        sta $D40F
        sta $D412

        ; SID 1 noise at maximum frequency.
        lda #$FF
        sta $D40E
        sta $D40F
        lda #$81
        sta $D412

        ; A mirror of SID 1 will now expose non-zero OSC3 here.
        ldx #$0A
intro_sid2_mirror_loop:
        ldy #$1B
        lda ($FB),y
        bne intro_sid2_probe_no
        dex
        bne intro_sid2_mirror_loop

        ; Candidate did NOT mirror SID 1. Stop SID 1.
        lda #$00
        sta $D412
        sta $D40E
        sta $D40F

        ; Now start candidate Voice 3 noise itself.
        lda #$08
        ldy #$12
        sta ($FB),y

        lda #$FF
        ldy #$0E
        sta ($FB),y
        iny
        sta ($FB),y

        lda #$80
        ldy #$12
        sta ($FB),y

        ; Give OSC3 time to advance.
        jsr intro_term_wait_frame

        ; Positive confirmation:
        ; require at least 3 changes across 8 candidate OSC3 reads.
        ldy #$1B
        lda ($FB),y
        sta hardware_profile
        lda #$00
        sta startup_intro_frame_counter
        ldx #$07
intro_sid2_activity_loop:
        ldy #$1B
        lda ($FB),y
        cmp hardware_profile
        beq intro_sid2_activity_same
        inc startup_intro_frame_counter
intro_sid2_activity_same:
        sta hardware_profile
        dex
        bne intro_sid2_activity_loop

        ; Stop candidate after probe.
        lda #$00
        ldy #$12
        sta ($FB),y
        ldy #$0E
        sta ($FB),y
        iny
        sta ($FB),y

        lda startup_intro_frame_counter
        cmp #$03
        bcc intro_sid2_probe_no_clean

        sec
        rts

intro_sid2_probe_no:
        ; Stop SID 1 if mirror / invalid candidate was seen.
        lda #$00
        sta $D412
        sta $D40E
        sta $D40F

intro_sid2_probe_no_clean:
        ; Also leave candidate Voice 3 off.
        lda #$00
        ldy #$12
        sta ($FB),y
        clc
        rts

        ; The UCI information-only probe was removed.
        ; JOY helper does its own initial scroll, immediately after DUAL SID.
intro_post_dual_sid:
        ; Fake JOY visual ONLY: no CIA reads, joystick probe or result inference.
        ; The original art's two OKs were hidden at initialization.
        jsr $1AA9  ; Red/pink heart while both OKs stay hidden.
        ldx #$06  ; 24 frames total: four visible six-frame color transitions.
intro_fake_joy_pause:
        jsr intro_term_pause
        dex
        bne intro_fake_joy_pause
        jsr $1AAC  ; Restore the original OK OK; heart solid red.
        jsr $1A40  ; Start existing IEC heartbeat; no IEC test changes.
        jsr intro_term_pause
        jsr intro_term_pause
        jsr intro_term_pause
        jsr $1900   ; IEC ACK test on 8-11; detection logic unchanged.
        jsr intro_term_pause
        jsr intro_term_pause
        jsr intro_term_pause
        jsr $1A43  ; IEC finished: freeze its heart solid red.
        jsr $1A17  ; Draw real 08/09/10/11 flags in both art screen pages.
        ; RAM tests execute beneath BASIC ROM ($A000-$BFFF).
        ; Temporarily clear LORAM, then restore exact original CPU port.
        lda $01
        pha
        and #$FE
        sta $01
        jsr $BFF0  ; Same RAM heart start; tail-jumps to unchanged test $BC60.
        pla
        sta $01

        ; Cosmetic-only COLOR RAM heart. No new test and no result text.
        ; The source artwork already contains this heart at column 38, row 18.
        lda #$0B
        sta $1FF6  ; Only new frame-handler state: COLOR RAM.
        lda #$00
        sta $1FF7
        lda #$02
        sta $DACD  ; Visible heart red; label and color sample unchanged.
        ldx #$06  ; 6 * 4 frames = 24, same fake animation as JOYSTICK.
intro_fake_color_heart_pause:
        jsr intro_term_pause
        dex
        bne intro_fake_color_heart_pause
        lda #$00
        sta $1FF6
        lda #$02
        sta $DACD  ; Stop color heartbeat, hold red.

        ; Cosmetic-only CHAR ROM heart, no ROM read and no OK/FAIL text.
        lda #$0C
        sta $1FF6
        lda #$00
        sta $1FF7
        lda #$02
        sta $DAF5  ; Row 19, column 38.
        ldx #$06
intro_fake_char_heart_pause:
        jsr intro_term_pause
        dex
        bne intro_fake_char_heart_pause
        lda #$00
        sta $1FF6
        lda #$02
        sta $DAF5  ; Stop char heartbeat, hold red.
        jmp intro_terminal_finished

        ; ---------------------------------------------------------
        ; Mark an existing diagnostic row.
        ; X = zero-based screen row.
        ; A = 0 -> NO (red), nonzero -> ON (green).
        ; Status is written in columns 38-39.
        ; Uses screen_lo/screen_hi lookup tables.
        ; ---------------------------------------------------------
intro_mark_status:
        ; FIX47D: DUAL SID adds one extra real history line.
        ; Rows VIDEO..SECOND SID therefore move up by one.
        ; No UCI row; other status placement logic is unchanged.
        cpx #$17
        beq intro_mark_status_row_ready
        ldy hardware_profile
        beq intro_mark_status_row_ready
        dex
intro_mark_status_row_ready:
        sta startup_intro_frame_counter

        lda $FB
        pha
        lda $FC
        pha

        lda screen_lo,x
        clc
        adc #$25
        sta $FB
        lda screen_hi,x
        adc #$00
        sta $FC

        lda startup_intro_frame_counter
        beq intro_mark_no

intro_mark_ok:
        ; FIX48: positive diagnostic state is displayed as ON.
        ldy #$00
        lda #$0F
        sta ($FB),y
        iny
        lda #$0E
        sta ($FB),y
        lda #$01
        bne intro_mark_color

intro_mark_no:
        ldy #$00
        lda #$0E
        sta ($FB),y
        iny
        lda #$0F
        sta ($FB),y
        lda #$01

intro_mark_color:
        sta startup_intro_frame_counter

        ; Same low byte; color RAM is screen RAM + $D400.
        lda $FC
        clc
        adc #$08
        sta $FC
        ldy #$00
        lda startup_intro_frame_counter
        sta ($FB),y
        iny
        sta ($FB),y

        pla
        sta $FC
        pla
        sta $FB
        rts

        ; ---------------------------------------------------------
        ; Espera de un frame fisico. No usa IRQ.
        ; ---------------------------------------------------------
intro_term_wait_frame:
intro_term_wait_hit:
        lda $D012
        cmp #251
        bne intro_term_wait_hit
intro_term_wait_leave:
        lda $D012
        cmp #251
        beq intro_term_wait_leave
        ; RUN/STOP durante el test: salida real a BASIC.
        ; Salva A y puertos CIA; no cambia X/Y ni los tests.
        jsr intro_check_runstop
        jsr intro_fake_color_char_heart_tick
        rts

        ; Dispatch original heartbeat unchanged for all original states (0..10).
        ; Only states 11/12 use the two new cosmetic heart positions.
        ; Preserve A. All callers overwrite processor flags after frame wait.
        ; No PHP/PLP: unsupported by this OrgAsm build and unnecessary here.
intro_fake_color_char_heart_tick:
        pha
        lda $1FF6
        cmp #$0B
        bcc intro_fake_color_char_original_tick
        cmp #$0D
        bcs intro_fake_color_char_original_tick
        inc $1FF7
        lda $1FF7
        cmp #$06
        bcc intro_fake_color_char_tick_done
        lda #$00
        sta $1FF7
        lda $1FF6
        cmp #$0B
        bne intro_fake_char_heart_flip
        lda $DACD
        eor #$08  ; VIC palette: red 2 <-> pink 10 (same as existing hearts).
        sta $DACD
        jmp intro_fake_color_char_tick_done
intro_fake_char_heart_flip:
        lda $DAF5
        eor #$08
        sta $DAF5
intro_fake_color_char_tick_done:
        pla
        rts
intro_fake_color_char_original_tick:
        pla
        jmp $1B68  ; Existing CPU/VIC/RAM/SID/IEC dispatch unchanged.

        ; Pausa corta entre lineas.
intro_term_pause:
        ; FIX24: pausa corta para meter muchos tests en ~10 segundos.
        ldy #4
intro_term_pause_loop:
        jsr intro_term_wait_frame
        dey
        bne intro_term_pause_loop
        rts

        ; FIX27B: filas 1..24 historial, fila 25 escritura.
intro_term_scroll:
        ; Rows 2..25 -> rows 1..24. Total: 960 bytes.
        ldx #$00
intro_term_scroll_pages:
        lda $0428,x
        sta $0400,x
        lda $0528,x
        sta $0500,x
        lda $0628,x
        sta $0600,x

        lda $0C28,x
        sta $0C00,x
        lda $0D28,x
        sta $0D00,x
        lda $0E28,x
        sta $0E00,x

        inx
        bne intro_term_scroll_pages

        ; Ultimos 192 bytes.
        ldx #$00
intro_term_scroll_tail:
        lda $0728,x
        sta $0700,x
        lda $0F28,x
        sta $0F00,x
        inx
        cpx #$C0
        bne intro_term_scroll_tail

        ; Limpiar fila 25.
intro_term_clear_row25:
        lda #$20
        ldx #$00
intro_term_clear_last:
        sta $07C0,x
        inx
        cpx #40
        bne intro_term_clear_last

        lda #$01
        ldx #$00
intro_term_clear_last_color:
        sta $0FC0,x
        inx
        cpx #40
        bne intro_term_clear_last_color
        rts

intro_terminal_finished:
        ; Row 22 key prompt stays hidden until the first sea frame runs.
        ; Row 23 remains blank; rows 24-25 are reserved for the animated sea.
        jsr intro_term_pause
        jsr $1C00  ; Restore art/color in screen $0400 before starting the approved sea.
        lda detected_machine
        jsr $1D00  ; Restore selected machine row after default artwork reload.
        jsr $1E0C  ; Preserve real LFSR/ENV3 FAIL on final artwork.
        jsr $1BC6  ; Preserve dynamically detected SID1 model on final $0400 art.
        jsr $18C7  ; Final art loader restores default heart colors: re-hide pending.
        jsr $CFF1  ; Same original completed hearts + basic results after reload.
        jsr $17E8  ; SID2 test finished too: preserve solid red on final reload.
        jsr $1AB2  ; Restore red DUAL and JOY hearts after artwork reload.
        lda hardware_profile
        jsr $3BAE  ; Restore SID2 actual address on final $0400 artwork.
        lda hardware_profile
        jsr $C3DD  ; Redraw model and MONO/STEREO after final art reload.
        jsr $1A17  ; Art reloaded: restore all four real IEC status values.
        jsr $1A43  ; Restore completed IEC heart in red after pending-heart reset.
        ; Loader hides pending hearts again: restore only these two finished
        ; cosmetic markers. No text / color sample / ROM sample is modified.
        lda #$02
        sta $DACD  ; COLOR RAM heart.
        sta $DAF5  ; CHAR ROM heart.
        jsr $1DF1  ; Hide row 22 again BEFORE switching to the reloaded art.
        lda #$1A
        sta $D018  ; $0400 screen + hybrid charset $2800 (same as approved version).

        ; Portada lista: el mensaje sigue oculto hasta completar todos los tests.
intro_press_key_setup:
        ; ---------------------------------------------------------
        ; FIX37: continuous dual-SID sea noise while waiting.
        ; The previous diagnostic results have already been marked,
        ; so these two bytes are now free to preserve $FB/$FC.
        ; ---------------------------------------------------------
        lda $FB
        sta startup_intro_seconds
        lda $FC
        sta startup_intro_second_counter

        lda #$00
        sta startup_intro_fps
        sta sid_ramp_frame_counter  ; Sea-only divider; demo resets it later.
        sta $3B46  ; Intro-only charset animation divider.
        sta $3B9E  ; Intro-only horizontal position divider.
        sta $3B9F  ; Intro-only subpixel offset (0..7).
        lda #$13  ; Initial column of the 2x2 sample.
        sta $3BA0  ; Intro-only horizontal position.

        ; SID1 wave: soft attack ($9), full sustain, release A.
        ; Stereo handoff is via envelopes, not $D418 (avoids volume clicks).
        lda #$90
        sta $D413
        lda #$FA
        sta $D414
        lda #$0F
        sta $D418
        lda #$81
        sta $D412

        ; If SID 2 was confirmed, point $FB/$FC at its real base.
        ; Compact lookup saves MAIN space before the fixed SID at $8C00.
        ldx hardware_profile
        beq intro_sea_setup_done
        lda intro_sid2_base_lo,x
        sta $FB
        lda intro_sid2_base_hi,x
        sta $FC

intro_sea_setup_sid2:
        ldy #$13
        lda #$90
        sta ($FB),y
        iny
        lda #$FA
        sta ($FB),y
        ldy #$18
        lda #$0F
        sta ($FB),y
        ; SID2 starts off; joins at phase $60, releases at $F0.
        ldy #$12
        lda #$80
        sta ($FB),y

intro_sea_setup_done:
        ; Set up low noise beds; initial frequency is updated by helper.
        ; X still contains hardware_profile and $FB/$FC points to SID2 if found.
        jsr $3A64
        ; Solo INTRO: preparar la entrada desde silencio, capas y filtro.
        ldx hardware_profile
        jsr $8400

        ; Save CIA1 configuration after sea setup.
        lda $DC00
        pha
        lda $DC02
        pha
        lda $DC03
        pha

        ; Port A salida / Port B entrada para scan de teclado.
        lda #$FF
        sta $DC02
        lda #$00
        sta $DC03

        ; Todos los tests YA terminaron. Mostrar el primer frame del mar y
        ; revelar AHORA PRESS A KEY, antes de aceptar cualquier pulsacion.
        jsr intro_sea_tick
        jsr intro_term_wait_frame
        jsr $3B8A  ; Restaura la fila original desde $1348 a $0748.
        jsr intro_sprite_window_init  ; Six sprites, overlay ONLY original 16-char sample.
        jsr intro_palette_scroll_init ; COLOR RAM row above: temporary palette 00..15.

        ; No aceptar la tecla con la que se lanzo el programa: soltar primero.
intro_press_key_wait_release_1:
        jsr intro_keyboard_any
        bne intro_press_key_wait_release_1

        ; Una sola lectura espuria ya NO puede iniciar la demo.
        ; Confirmar tecla pulsada en dos frames distintos.
intro_press_key_wait_press:
        jsr intro_keyboard_any
        beq intro_press_key_no_press
        jsr intro_term_wait_frame
        jsr intro_keyboard_any
        bne intro_press_key_got_press
intro_press_key_no_press:
        jsr intro_sea_tick
        jsr intro_sprite_window_tick  ; Sprite animation reads current charset bitmap.
        jsr intro_palette_scroll_tick ; Rotate 16 COLOR RAM cells LEFT; no sprite conflict.
        jsr intro_term_wait_frame
        jmp intro_press_key_wait_press

intro_press_key_got_press:
        jsr intro_prompt_s_source_scan ; Referencia simbolica: fuerza incluir el bloque $1A2E.
        jsr intro_sprite_window_stop  ; Disable sprites, restore the 16 original codes.
        ; FIX39: stop modulation and blank the screen immediately.
        lda #$0B
        sta $D011
        lda #$00
        sta $D020
        sta $D021

        ; El fade se realiza con los GATE encendidos; apagarlos SOLO en volumen 0.
        jsr intro_sea_handoff

        ; Mar ya silenciado: esperar a que se suelte la tecla.
intro_press_key_wait_release_2:
        jsr intro_keyboard_any
        beq intro_press_key_restore
        jsr intro_term_wait_frame
        jmp intro_press_key_wait_release_2

intro_press_key_restore:
        pla
        sta $DC03
        pla
        sta $DC02
        pla
        sta $DC00

        ; Restore original zero-page pointer for the real demo.
        lda startup_intro_seconds
        sta $FB
        lda startup_intro_second_counter
        sta $FC

        jmp intro_prompt_s_source_dispatch ; Referencia simbolica: fuerza incluir el bloque $1A94.

        ; ---------------------------------------------------------
        ; FIX37: one frame of dual-SID sea modulation.
        ; startup_intro_fps = phase.
        ; hardware_profile  = 0 none, 1 DE00, 2 D420, 3 D500.
        ; If SID2 exists, $FB/$FC already point to its base.
        ; ---------------------------------------------------------
intro_sea_tick:
        ; SOLO INTRO: sostener cada cresta 5 s ADICIONALES en PAL/NTSC.
        ; Mantener la MISMA fase para audio y caracteres; no adelantar la
        ; siguiente ola durante el rompimiento. Contador en BIN $8409.
        lda startup_intro_fps
        and #$7F
        cmp #$60               ; crestas globales $60 y $E0.
        bne intro_sea_tick_step
        ldx detected_machine   ; 0..2 PAL, 3..4 NTSC.
        jsr $8409
        beq intro_sea_hold_phase
        ; Termino la espera: salir de la cresta de una vez.
        inc startup_intro_fps
        lda #$08               ; conservar alineacion de fases 16/8 cuadros.
        sta sid_ramp_frame_counter
        jmp intro_sea_hold_phase
intro_sea_tick_step:
        ; Calma larga que ya gustaba: $10-$1F y $90-$9F.
        inc sid_ramp_frame_counter
        lda startup_intro_fps
        and #$7F
        cmp #$10
        bcc intro_sea_step_normal
        cmp #$20
        bcs intro_sea_step_normal
        lda sid_ramp_frame_counter
        and #$0F
        bne intro_sea_hold_phase
        jmp intro_sea_step_advance
intro_sea_step_normal:
        ; SOLO ASCENSO: $20-$5F / $A0-$DF pasan de 6 a 4 frames.
        ; $00-$0F, calma $10-$1F, cresta y retirada: sin cambios.
        lda startup_intro_fps
        and #$7F
        cmp #$20
        bcc intro_sea_step_eight
        cmp #$60
        bcs intro_sea_step_eight
        lda sid_ramp_frame_counter
        and #$07               ; acepta el contador al entrar desde la calma
        cmp #$04
        bne intro_sea_hold_phase
        lda #$00
        sta sid_ramp_frame_counter
        jmp intro_sea_step_advance
intro_sea_step_eight:
        lda sid_ramp_frame_counter
        and #$07
        bne intro_sea_hold_phase
intro_sea_step_advance:
        inc startup_intro_fps
intro_sea_hold_phase:
        ; No new per-frame variables or changes to the SID player.
        lda startup_intro_fps
        ldx hardware_profile
        jsr $3ABC
        ; Solo INTRO: fade de volumen, filtro de cresta y deriva por ola.
        lda startup_intro_fps
        ldx hardware_profile
        jsr $8403
        lda startup_intro_fps
        ldx hardware_profile
        jsr $1800  ; Intro-only smooth screen movement.
        rts

        ; ---------------------------------------------------------
        ; INTRO EXIT: fade completo ANTES del GATE OFF (SID1 y SID2).
        ; Prueba: fade largo de 80 cuadros fisicos (1.6 s PAL).
        ; $8871/$8872 son fade_volume/fade_divider del BIN de INTRO:
        ; accesos a RAM, NUNCA lecturas de registros SID write-only.
        ; ---------------------------------------------------------
intro_sea_handoff:
intro_sea_handoff_pause:
        ldx #$50
intro_black_pause_loop:
        ; Techo = floor(3 * cuadros_restantes / 16): 15..0 en 80 cuadros.
        ; Misma longitud de codigo: LSR en vez de ASL; evita mover direcciones.
        ; Nunca subir el techo anterior: permite salir tambien durante fade-in.
        txa
        lsr
        sta startup_intro_frame_counter
        txa
        clc
        adc startup_intro_frame_counter
        lsr
        lsr
        lsr
        cmp $8871
        bcs intro_exit_cap_ready
        sta $8871
intro_exit_cap_ready:
        ; El TICK normal aumenta el fade-in cada 12 cuadros; bloquearlo
        ; exclusivamente mientras dura esta salida.
        lda #$00
        sta $8872
        txa
        pha
        ; Fase congelada: misma ola/filtro/espuma, ningun nuevo comienzo.
        ; El tick recalcula los DOS volumenes con el techo descendente.
        lda startup_intro_fps
        ldx hardware_profile
        jsr $8403
        pla
        tax
        jsr intro_term_wait_frame
        dex
        bne intro_black_pause_loop

        ; El ultimo TICK dejo volumen 0 en ambos chips. Ahora si:
        ; mantener volumen en 0, soltar las voces y desactivar el filtro.
        ; NO llamar $8406: ese cleanup restablecia volumen $0F y
        ; volvia audible la cola de release durante el cambio a VICIOS.
        lda #$00
        sta $D418
        ldx hardware_profile
        beq intro_exit_sid2_muted
        ldy #$18
        sta ($FB),y
intro_exit_sid2_muted:
        ldx hardware_profile
        jsr $3AA7
        lda #$00
        sta $D417
        ldx hardware_profile
        beq intro_exit_cleanup_done
        ldy #$17
        sta ($FB),y
intro_exit_cleanup_done:
        rts

        ; ---------------------------------------------------------
        ; A != 0 si hay alguna tecla del teclado pulsada.
        ; Con PA=$FF obtenemos el estado base de PB (incluye joystick 1).
        ; Con PA=$00 activamos todas las columnas del teclado.
        ; AND con la base filtra bits de joystick mantenidos.
        ; ---------------------------------------------------------
intro_keyboard_any:
        lda #$FF
        sta $DC00
        lda $DC01
        sta startup_intro_frame_counter

        lda #$00
        sta $DC00
        lda $DC01
        eor #$FF
        and startup_intro_frame_counter
        ; Tambien acepta RUN/STOP en el prompt final (incluso en wait_release).
        jsr intro_check_runstop
        rts

        ; Escanear SOLO PA7/PB7 y restaurar exactamente puertos CIA1.
        ; Con salida a BASIC, la rutina existente restablece CIA/KERNAL.
intro_check_runstop:
        pha
        lda $DC00
        pha
        lda $DC02
        pha
        lda $DC03
        pha
        lda #$FF
        sta $DC02
        lda #$00
        sta $DC03
        lda #$7F
        sta $DC00
        lda $DC01
        and #$80
        beq intro_runstop_to_basic
        pla
        sta $DC03
        pla
        sta $DC02
        pla
        sta $DC00
        pla
        rts
intro_runstop_to_basic:
        jmp _vote_basic_exit_common

        ; ---------------------------------------------------------
        ; EXPERIMENTAL 16-CELL VERTICAL CHARSET WINDOW. Intro ONLY.
        ; - Char sample: screen $06E4..$06F3, row 19, columns 21..36.
        ; - Six MONO sprites: x=184..304, y=194; original sample is white.
        ; - Sprite data: $3000..$317F (screen B, idle until demo init).
        ; - Original charset $2800..$2FFF remains READ-ONLY, including
        ;   all live custom/animated glyphs. No VIC fine-scroll changes.
        ; - All 16 columns scroll UP as a single group, 1 pixel per step.
        ; - Next group is +16 glyphs, wraps $F0..$FF => $00..$0F.
        ; - Six sprite Y-rows 8..20 remain zero: no drawing in next row.
        ; - The demo's RenderizarBinarios clears screen B AFTER intro.
        ; ---------------------------------------------------------
intro_sprite_window_init:
        pha
        txa
        pha
        tya
        pha

        lda #$00
        sta intro_sprite_group
        sta intro_sprite_phase
        sta intro_sprite_divider
        sta intro_sprite_row
        lda #$28
        sta intro_sprite_hold  ; Mantener grupo 40 cuadros, sincronizado al mar lento.

        ; Preserve X-high register, and discard original screen-B data
        ; only after EVERY test, when screen $0400 is the visible artwork.
        lda $D010
        sta intro_sprite_saved_xhi
        lda #$00
        ldx #$3F
intro_sprite_window_clear:
        sta $3000,x
        sta $3040,x
        sta $3080,x
        sta $30C0,x
        sta $3100,x
        sta $3140,x
        dex
        bpl intro_sprite_window_clear

        ; Blank ONLY the 16 characters beneath sprite pixels. The blank
        ; glyph 32 is already 00 00 ... in the existing charset.
        lda #$20
        ldx #$00
intro_sprite_window_blank:
        sta $06E4,x
        inx
        cpx #$10
        bne intro_sprite_window_blank

        ; Screen $0400 sprite pointers $07F8..$07FD => $3000..$3140.
        lda #$C0
        ldx #$00
intro_sprite_window_pointers:
        sta $07F8,x
        clc
        adc #$01
        inx
        cpx #$06
        bne intro_sprite_window_pointers

        ; Use six independent 24px-wide sprites to cover 128px total.
        ; The 6th sprite has only one used byte per scanline.
        lda #$38
        sta $D010  ; Sprite indices 3,4,5 have X >=256.
        lda #$00
        sta $D017  ; Disable Y-expansion.
        sta $D01D  ; Disable X-expansion.
        sta $D01C  ; Monochrome sprites, exact original 1-bit bitmap.
        sta $D01B  ; Foreground priority over blank sample cells.
        lda #$01  ; Sample's ORIGINAL WHITE color.
        sta $D027
        sta $D028
        sta $D029
        sta $D02A
        sta $D02B
        sta $D02C
        lda #$C2  ; Sprite top matches screen row 18 (0-based): 50+18*8.
        sta $D001
        sta $D003
        sta $D005
        sta $D007
        sta $D009
        sta $D00B
        lda #$B8  ; X=184, 208, 232, 256, 280, 304.
        sta $D000
        lda #$D0
        sta $D002
        lda #$E8
        sta $D004
        lda #$00
        sta $D006
        lda #$18
        sta $D008
        lda #$30
        sta $D00A

        jsr intro_sprite_window_render
        lda #$3F
        sta $D015  ; Enable only sprites 0..5, after initial bitmap built.
        pla
        tay
        pla
        tax
        pla
        rts

intro_sprite_window_tick:
        pha
        txa
        pha
        tya
        pha
        lda intro_sprite_hold
        beq intro_sprite_window_advance
        dec intro_sprite_hold
        jmp intro_sprite_window_redraw
intro_sprite_window_advance:
        inc intro_sprite_divider
        lda intro_sprite_divider
        cmp #$08  ; Un pixel cada 8 cuadros; acompana ciclo del mar.
        bcc intro_sprite_window_redraw
        lda #$00
        sta intro_sprite_divider
        inc intro_sprite_phase
        lda intro_sprite_phase
        cmp #$08
        bcc intro_sprite_window_redraw
        lda #$00
        sta intro_sprite_phase
        inc intro_sprite_group
        lda intro_sprite_group
        and #$0F
        sta intro_sprite_group
        lda #$28
        sta intro_sprite_hold
intro_sprite_window_redraw:
        ; Render on every idle frame: animated custom glyphs continue moving.
        jsr intro_sprite_window_render
        pla
        tay
        pla
        tax
        pla
        rts

intro_sprite_window_stop:
        pha
        txa
        pha
        lda #$00
        sta $D015  ; Stop overlay before returning to original demo.
        lda intro_sprite_saved_xhi
        sta $D010
        ldx #$00
intro_sprite_window_restore:
        txa
        sta $06E4,x  ; Restore EXACT original screen codes $00..$0F.
        inx
        cpx #$10
        bne intro_sprite_window_restore
        pla
        tax
        pla
        rts

intro_sprite_window_render:
        ; Preserve ZP $22/$23 (also used later by demo char engine).
        pha
        txa
        pha
        tya
        pha
        lda $22
        pha
        lda $23
        pha

        ; Group start character = group * 16; charset base = $2800+group*128.
        lda intro_sprite_group
        lsr
        clc
        adc #$28
        sta intro_sprite_old_hi
        lda intro_sprite_group
        and #$01
        beq intro_sprite_window_old_low_zero
        lda #$80
intro_sprite_window_old_low_ready:
        sta intro_sprite_old_lo
        jmp intro_sprite_window_next_group
intro_sprite_window_old_low_zero:
        lda #$00
        jmp intro_sprite_window_old_low_ready
intro_sprite_window_next_group:
        lda intro_sprite_group
        clc
        adc #$01
        and #$0F
        pha
        lsr
        clc
        adc #$28
        sta intro_sprite_next_hi
        pla
        and #$01
        beq intro_sprite_window_next_low_zero
        lda #$80
intro_sprite_window_next_low_ready:
        sta intro_sprite_next_lo
        jmp intro_sprite_window_rows_begin
intro_sprite_window_next_low_zero:
        lda #$00
        jmp intro_sprite_window_next_low_ready

intro_sprite_window_rows_begin:
        lda #$00
        sta intro_sprite_row
        ldx #$00  ; 3 bytes per scanline in sprite bitmap.
intro_sprite_window_row_loop:
        lda intro_sprite_row
        clc
        adc intro_sprite_phase
        cmp #$08
        bcc intro_sprite_window_source_old
        ; New group enters from bottom: glyph row = r+phase-8.
        sbc #$08
        ora intro_sprite_next_lo  ; 128-byte aligned source groups.
        sta $22
        lda intro_sprite_next_hi
        sta $23
        jmp intro_sprite_window_source_ready
intro_sprite_window_source_old:
        ora intro_sprite_old_lo
        sta $22
        lda intro_sprite_old_hi
        sta $23
intro_sprite_window_source_ready:
        ; Unrolled 16 char reads; source offset 8*character_index.
        ; 6 sprite strips = [3+3+3+3+3+1] characters per row.
        ldy #$00
        lda ($22),y
        sta $3000,x
        ldy #$08
        lda ($22),y
        sta $3001,x
        ldy #$10
        lda ($22),y
        sta $3002,x
        ldy #$18
        lda ($22),y
        sta $3040,x
        ldy #$20
        lda ($22),y
        sta $3041,x
        ldy #$28
        lda ($22),y
        sta $3042,x
        ldy #$30
        lda ($22),y
        sta $3080,x
        ldy #$38
        lda ($22),y
        sta $3081,x
        ldy #$40
        lda ($22),y
        sta $3082,x
        ldy #$48
        lda ($22),y
        sta $30C0,x
        ldy #$50
        lda ($22),y
        sta $30C1,x
        ldy #$58
        lda ($22),y
        sta $30C2,x
        ldy #$60
        lda ($22),y
        sta $3100,x
        ldy #$68
        lda ($22),y
        sta $3101,x
        ldy #$70
        lda ($22),y
        sta $3102,x
        ldy #$78
        lda ($22),y
        sta $3140,x
        inc intro_sprite_row
        inx
        inx
        inx
        cpx #$18
        beq intro_sprite_window_render_done
        jmp intro_sprite_window_row_loop
intro_sprite_window_render_done:
        pla
        sta $23
        pla
        sta $22
        pla
        tay
        pla
        tax
        pla
        rts

        ; ---------------------------------------------------------
        ; COLOR RAM SAMPLE: independent 16-CELL LEFTWARD COLOR CYCLE.
        ; ORIGINAL artwork has one blank cell ($06BC), then 15 filled
        ; cells ($06BD..$06CB). Use precisely these 16 positions.
        ; Display original hardware colors 0..15: color zero is BLACK,
        ; intentionally invisible against black background. The existing
        ; $A0 charset glyph is a filled 8x8 block; charset is untouched.
        ; Color RAM palette ONLY: $DABC..$DACB, gap $DACC and heart $DACD untouched,
        ; grey label, border, charset, SID, or sprite registers.
        ; ONE 8-pixel cell left every 8 idle frames. Hardware cannot
        ; blend 16 arbitrary colors at subcell steps via COLOR RAM only.
        ; Animation stops and restores exact BIN artwork when key pressed.
        ; ---------------------------------------------------------
intro_palette_scroll_init:
        pha
        txa
        pha
        lda #$00
        sta intro_palette_divider
        ldx #$00
intro_palette_scroll_init_loop:
        txa                       ; Color code x: 0..15.
        sta $DABC,x
        inx
        cpx #$10
        bne intro_palette_scroll_init_loop
        lda #$A0                  ; First slot was originally blank.
        sta $06BC                ; First SAMPLE cell; keep the blank gap at $06CC.
        pla
        tax
        pla
        rts

intro_palette_scroll_tick:
        pha
        txa
        pha
        inc intro_palette_divider
        lda intro_palette_divider
        cmp #$08                 ; One COLOR CELL every 8 idle frames.
        bcc intro_palette_scroll_tick_done
        lda #$00
        sta intro_palette_divider
        lda $DABC               ; Keep exact outgoing color (including 0).
        pha
        ldx #$00
intro_palette_scroll_shift:
        lda $DABD,x
        sta $DABC,x
        inx
        cpx #$0F
        bne intro_palette_scroll_shift
        pla
        sta $DACB               ; Wrap first color to last cell.
intro_palette_scroll_tick_done:
        pla
        tax
        pla
        rts

intro_palette_scroll_stop:
        pha
        txa
        pha
        ldx #$00
intro_palette_scroll_restore:
        txa                       ; x=1..15 => original colors 1..15.
        cpx #$00
        bne intro_palette_scroll_restore_write
        lda #$03                  ; Original color of blank cell col20.
intro_palette_scroll_restore_write:
        sta $DABC,x
        inx
        cpx #$10
        bne intro_palette_scroll_restore
        lda #$20
        sta $06BC               ; Restore original empty FIRST cell; gap remains untouched.
        pla
        tax
        pla
        rts

intro_press_key_done:
    ");

    // EXIT: fade de 40 cuadros y GATE OFF a volumen 0; musica inicializa su propio SID.
end;

procedure AplicarDegradeLineal();
begin
    asm("
        pha
        txa
        pha
        tya
        pha
        lda linear_subdivision
        bne linear_sub_not_zero
        lda #1
        sta linear_subdivision
linear_sub_not_zero:
        lda linear_subdivision
        cmp #9
        bcc linear_sub_valid
        lda #8
        sta linear_subdivision
linear_sub_valid:
        lda #9
        sec
        sbc linear_subdivision
        sta linear_band_rows
        lda #0
        sta linear_phase
        sta linear_repeat
        sta linear_row
linear_row_loop:
        lda linear_mirror
        beq linear_target_normal
        lda #24
        sec
        sbc linear_row
        tax
        jmp linear_target_ready
linear_target_normal:
        ldx linear_row
linear_target_ready:
        lda color_lo,x
        sta $FC
        lda color_hi,x
        sta $FD
        lda linear_phase
        asl
        tax
        lda color_degrade,x
        ldy #39
linear_cell_loop:
        sta ($FC),y
        dey
        bpl linear_cell_loop
        inc linear_repeat
        lda linear_repeat
        cmp linear_band_rows
        bcc linear_phase_done
        lda #0
        sta linear_repeat
        inc linear_phase
        lda linear_phase
        cmp #6
        bcc linear_phase_done
        lda #0
        sta linear_phase
linear_phase_done:
        inc linear_row
        lda linear_row
        cmp #25
        beq linear_done
        jmp linear_row_loop
linear_done:
        pla
        tay
        pla
        tax
        pla
    ");
end;
procedure AplicarDegradeVertical();
begin
    asm("
        pha
        txa
        pha
        tya
        pha
        lda vertical_subdivision
        bne vertical_geo_sub_not_zero
        lda #1
        sta vertical_subdivision
vertical_geo_sub_not_zero:
        lda vertical_subdivision
        cmp #5
        bcc vertical_geo_sub_valid
        lda #4
        sta vertical_subdivision
vertical_geo_sub_valid:
        lda vertical_subdivision
        sec
        sbc #1
        sta vertical_table_base
        asl
        sta vertical_row
        asl
        clc
        adc vertical_row
        sta vertical_table_base
        lda #0
        sta vertical_phase
        sta vertical_repeat
        sta vertical_col
vertical_geo_col_loop:
        lda vertical_table_base
        clc
        adc vertical_phase
        tax
        lda vertical_phase_width_table,x
        sta vertical_band_cols
        lda vertical_phase
        asl
        tax
        lda color_degrade,x
        sta vertical_current_color
        lda vertical_mirror
        beq vertical_geo_target_normal
        lda #39
        sec
        sbc vertical_col
        jmp vertical_geo_target_ready
vertical_geo_target_normal:
        lda vertical_col
vertical_geo_target_ready:
        clc
        adc vertical_scroll_offset
        cmp #40
        bcc vertical_geo_target_ok
        sbc #40
vertical_geo_target_ok:
        tax
        lda vertical_current_color
        sta $D800,x
        sta $D828,x
        sta $D850,x
        sta $D878,x
        sta $D8A0,x
        sta $D8C8,x
        sta $D8F0,x
        sta $D918,x
        sta $D940,x
        sta $D968,x
        sta $D990,x
        sta $D9B8,x
        sta $D9E0,x
        sta $DA08,x
        sta $DA30,x
        sta $DA58,x
        sta $DA80,x
        sta $DAA8,x
        sta $DAD0,x
        sta $DAF8,x
        sta $DB20,x
        sta $DB48,x
        sta $DB70,x
        sta $DB98,x
        sta $DBC0,x
        inc vertical_repeat
        lda vertical_repeat
        cmp vertical_band_cols
        bcc vertical_geo_phase_done
        lda #0
        sta vertical_repeat
        inc vertical_phase
        lda vertical_phase
        cmp #6
        bcc vertical_geo_phase_done
        lda #0
        sta vertical_phase
vertical_geo_phase_done:
        inc vertical_col
        lda vertical_col
        cmp #40
        beq vertical_geo_done
        jmp vertical_geo_col_loop
vertical_geo_done:
        pla
        tay
        pla
        tax
        pla
    ");
end;
procedure ActualizarScrollDegradeVertical();
begin
    if vertical_scroll_enabled = 1 then begin
        if vertical_scroll_speed < 1 then begin
            vertical_scroll_speed := 1;
        end;
        if vertical_scroll_counter < vertical_scroll_speed then begin
            inc(vertical_scroll_counter);
        end;
        if vertical_scroll_counter >= vertical_scroll_speed then begin
            if scroll_coarse_event = 0 then begin
                vertical_scroll_counter := 0;
                if vertical_scroll_motion = 0 then begin
                    if vertical_scroll_direction = 0 then begin
                        inc(vertical_scroll_offset);
                        if vertical_scroll_offset >= 40 then begin
                            vertical_scroll_offset := 0;
                        end;
                    end
                    else begin
                        if vertical_scroll_offset = 0 then begin
                            vertical_scroll_offset := 39;
                        end
                        else begin
                            dec(vertical_scroll_offset);
                        end;
                    end;
                end
                else begin
                    if vertical_scroll_direction = 0 then begin
                        if vertical_scroll_offset >= 39 then begin
                            vertical_scroll_direction := 1;
                            if vertical_scroll_offset > 0 then begin
                                dec(vertical_scroll_offset);
                            end;
                        end
                        else begin
                            inc(vertical_scroll_offset);
                        end;
                    end
                    else begin
                        if vertical_scroll_offset = 0 then begin
                            vertical_scroll_direction := 0;
                            inc(vertical_scroll_offset);
                        end
                        else begin
                            dec(vertical_scroll_offset);
                        end;
                    end;
                end;
                AplicarDegradeVertical();
            end;
        end;
    end;
end;
procedure AplicarDegradeRadialSlice();
begin
    asm("
        pha
        txa
        pha
        tya
        pha
        lda radial_subdivision
        bne radial_sub_not_zero
        lda #1
        sta radial_subdivision
radial_sub_not_zero:
        cmp #5
        bcc radial_sub_valid
        lda #4
        sta radial_subdivision
radial_sub_valid:
        sec
        sbc #1
        asl
        asl
        asl
        asl
        asl
        asl
        sta radial_lut_base
        lda radial_anchor
        cmp #9
        bcc radial_anchor_valid
        lda #0
        sta radial_anchor
radial_anchor_valid:
        lda radial_slice
        beq radial_slice_0
        cmp #1
        beq radial_slice_1
        cmp #2
        beq radial_slice_2
radial_slice_3:
        lda #19
        sta radial_row
        lda #6
        sta radial_rows_left
        jmp radial_slice_setup
radial_slice_0:
        lda #0
        sta radial_row
        lda #7
        sta radial_rows_left
        jmp radial_slice_setup
radial_slice_1:
        lda #7
        sta radial_row
        lda #6
        sta radial_rows_left
        jmp radial_slice_setup
radial_slice_2:
        lda #13
        sta radial_row
        lda #6
        sta radial_rows_left
radial_slice_setup:
        ldx radial_anchor
        lda radial_anchor_lo,x
        sta $FA
        lda radial_anchor_hi,x
        sta $FB
        ldx radial_row
        clc
        lda $FA
        adc radial_row_offset_lo,x
        sta $FA
        lda $FB
        adc radial_row_offset_hi,x
        sta $FB
        lda color_lo,x
        sta $FC
        lda color_hi,x
        sta $FD
radial_slice_rows:
        ldy #39
radial_cell_loop:
        lda ($FA),y
        ora radial_lut_base
        tax
        lda radial_phase_lut,x
        clc
        adc radial_phase
        cmp #6
        bcc radial_phase_ok
        sbc #6
radial_phase_ok:
        tax
        lda radial_palette,x
        sta ($FC),y
        dey
        bpl radial_cell_loop
        clc
        lda $FA
        adc #40
        sta $FA
        bcc radial_map_no_carry
        inc $FB
radial_map_no_carry:
        clc
        lda $FC
        adc #40
        sta $FC
        bcc radial_color_no_carry
        inc $FD
radial_color_no_carry:
        dec radial_rows_left
        bne radial_slice_rows
        pla
        tay
        pla
        tax
        pla
    ");
end;
procedure AplicarDegradeRadialCompleto();
begin
    radial_slice := 0;
    AplicarDegradeRadialSlice();
    radial_slice := 1;
    AplicarDegradeRadialSlice();
    radial_slice := 2;
    AplicarDegradeRadialSlice();
    radial_slice := 3;
    AplicarDegradeRadialSlice();
    radial_slice := 0;
    radial_update_active := 0;
end;
procedure ActualizarDegradeRadial();
begin
    if radial_scroll_enabled = 1 then begin
        if radial_scroll_speed < 1 then begin
            radial_scroll_speed := 1;
        end;
        if radial_update_active = 1 then begin
            if scroll_coarse_event = 0 then begin
                AplicarDegradeRadialSlice();
                inc(radial_slice);
                if radial_slice > 3 then begin
                    radial_slice := 0;
                    radial_update_active := 0;
                    radial_scroll_counter := 0;
                    if radial_anchor_motion_enabled = 1 then begin
                        if radial_anchor_motion_period < 1 then begin
                            radial_anchor_motion_period := 1;
                        end;
                        inc(radial_anchor_motion_counter);
                        if radial_anchor_motion_counter >= radial_anchor_motion_period then begin
                            radial_anchor_motion_counter := 0;
                            if radial_anchor_motion_direction = 0 then begin
                                inc(radial_anchor_motion_index);
                                if radial_anchor_motion_index > 7 then begin
                                    radial_anchor_motion_index := 0;
                                end;
                            end
                            else begin
                                if radial_anchor_motion_index = 0 then begin
                                    radial_anchor_motion_index := 7;
                                end
                                else begin
                                    dec(radial_anchor_motion_index);
                                end;
                            end;
                            radial_anchor := radial_anchor_path[radial_anchor_motion_index];
                        end;
                    end;
                end;
            end;
        end
        else begin
            inc(radial_scroll_counter);
            if radial_scroll_counter >= radial_scroll_speed then begin
                radial_scroll_counter := 0;
                if radial_direction = 0 then begin
                    if radial_phase = 0 then begin
                        radial_phase := 5;
                    end
                    else begin
                        dec(radial_phase);
                    end;
                end
                else begin
                    inc(radial_phase);
                    if radial_phase > 5 then begin
                        radial_phase := 0;
                    end;
                end;
                radial_slice := 0;
                radial_update_active := 1;
            end;
        end;
    end;
end;
procedure AplicarDegradePeriodico();
begin
    asm("
        pha
        txa
        pha
        tya
        pha
        lda cross_row_period
        bne cross_period_ok
        lda #1
        sta cross_row_period
cross_period_ok:
        lda cross_subdivision
        bne cross_sub_not_zero
        lda #1
        sta cross_subdivision
cross_sub_not_zero:
        lda cross_subdivision
        cmp #9
        bcc cross_sub_valid
        lda #8
        sta cross_subdivision
cross_sub_valid:
        lda cross_mirror
        beq cross_mirror_valid
        lda #1
        sta cross_mirror
cross_mirror_valid:
        lda cross_subdivision
        cmp #1
        bne cross_width_2
        lda #10
        jmp cross_width_store
cross_width_2:
        cmp #2
        bne cross_width_3
        lda #8
        jmp cross_width_store
cross_width_3:
        cmp #3
        bne cross_width_4
        lda #6
        jmp cross_width_store
cross_width_4:
        cmp #4
        bne cross_width_5
        lda #5
        jmp cross_width_store
cross_width_5:
        cmp #5
        bne cross_width_6
        lda #4
        jmp cross_width_store
cross_width_6:
        cmp #6
        bne cross_width_7
        lda #3
        jmp cross_width_store
cross_width_7:
        cmp #7
        bne cross_width_8
        lda #2
        jmp cross_width_store
cross_width_8:
        lda #1
cross_width_store:
        sta cross_band_width
        lda #0
        sta cross_phase
        sta cross_repeat
        sta cross_row
cross_row_loop:
        ldx cross_row
        lda color_lo,x
        sta $FC
        lda color_hi,x
        sta $FD
        lda cross_phase
        sta cross_idx
        lda cross_mirror
        bne cross_fill_mirror
        ldy #0
cross_band_next:
        ldx cross_idx
        lda color_degrade,x
        sta cross_current_color
        lda cross_band_width
        sta cross_band_remaining
cross_pixel_loop:
        lda cross_current_color
        sta ($FC),y
        iny
        cpy #40
        beq cross_row_complete
        dec cross_band_remaining
        bne cross_pixel_loop
        lda cross_idx
        clc
        adc #2
        cmp #25
        bcc cross_idx_store
        sbc #25
cross_idx_store:
        sta cross_idx
        jmp cross_band_next
cross_fill_mirror:
        ldy #39
cross_band_next_mirror:
        ldx cross_idx
        lda color_degrade,x
        sta cross_current_color
        lda cross_band_width
        sta cross_band_remaining
cross_pixel_loop_mirror:
        lda cross_current_color
        sta ($FC),y
        dey
        cpy #$FF
        beq cross_row_complete
        dec cross_band_remaining
        bne cross_pixel_loop_mirror
        lda cross_idx
        clc
        adc #2
        cmp #25
        bcc cross_idx_store_mirror
        sbc #25
cross_idx_store_mirror:
        sta cross_idx
        jmp cross_band_next_mirror
cross_row_complete:
        inc cross_repeat
        lda cross_repeat
        cmp cross_row_period
        bcc cross_phase_done
        lda #0
        sta cross_repeat
        lda cross_phase
        clc
        adc #2
        cmp #25
        bcc cross_phase_store
        sbc #25
cross_phase_store:
        sta cross_phase
cross_phase_done:
        inc cross_row
        lda cross_row
        cmp #25
        beq cross_done
        jmp cross_row_loop
cross_done:
        pla
        tay
        pla
        tax
        pla
    ");
end;
procedure AplicarBlinkGlobal();
var
begin
    if blink_global_black = 1 then begin
        if blink_global_phase > 8 then begin
            blink_global_phase := 0;
        end;
        col_val := blink_sequence_black[blink_global_phase];
    end
    else begin
        if blink_global_phase > 5 then begin
            blink_global_phase := 0;
        end;
        col_val := blink_sequence_gray[blink_global_phase];
    end;
    asm("
        pha
        txa
        pha
        lda col_val
        ldx #$00
fill_color_ram:
        sta $D800,x
        sta $D900,x
        sta $DA00,x
        inx
        bne fill_color_ram
        ldx #$00
fill_remaining:
        sta $DB00,x
        inx
        cpx #$E8
        bne fill_remaining
        pla
        tax
        pla
    ");
end;
procedure ActualizarBlinkGlobal();
begin
    inc(blink_global_counter);
    if blink_global_counter >= blink_global_speed then begin
        blink_global_counter := 0;
        inc(blink_global_phase);
        if blink_global_black = 1 then begin
            if blink_global_phase > 8 then begin
                blink_global_phase := 0;
            end;
        end
        else begin
            if blink_global_phase > 5 then begin
                blink_global_phase := 0;
            end;
        end;
        AplicarBlinkGlobal();
    end;
end;
// | >>> STAGE 13 :: BLINK CONSTANTE                                             |
// | El ghost scroll controla solamente la duracion total del Stage 13.          |
procedure ActualizarBlinkStage13Constante();
begin
    // Blink constante durante todo Stage 13.
    if show_stage = 13 then begin
        if stage13_static_active = 1 then begin
            blink_global_speed := stage13_blink_speed;
        end;
    end;
end;
// | Rotacion de Stages 11/12:                                                    |
procedure AplicarMapaRotatorioBin();
begin
    asm("
        pha
        txa
        pha
        tya
        pha
        lda #0
        sta rotating_bin_mirror
        lda rotating_lines_step
        cmp #1
        beq rot_bin_step1
        cmp #2
        beq rot_bin_step2
        cmp #3
        beq rot_bin_step3
        cmp #5
        beq rot_bin_step5
        cmp #6
        beq rot_bin_step6
rot_bin_step7:
        lda #$60            ; frame0, ultima fila: $B460
        sta $FA
        lda #$B4
        sta $FB
        lda #1
        sta rotating_bin_mirror
        jmp rot_bin_source_ready
rot_bin_step6:
        lda #$48            ; frame1, ultima fila: $B848
        sta $FA
        lda #$B8
        sta $FB
        lda #1
        sta rotating_bin_mirror
        jmp rot_bin_source_ready
rot_bin_step5:
        lda #$30            ; frame2, ultima fila: $BC30
        sta $FA
        lda #$BC
        sta $FB
        lda #1
        sta rotating_bin_mirror
        jmp rot_bin_source_ready
rot_bin_step3:
        lda #$70            ; frame2: $B870
        sta $FA
        lda #$B8
        sta $FB
        jmp rot_bin_source_ready
rot_bin_step2:
        lda #$88            ; frame1: $B488
        sta $FA
        lda #$B4
        sta $FB
        jmp rot_bin_source_ready
rot_bin_step1:
        lda #$A0            ; frame0: $B0A0
        sta $FA
        lda #$B0
        sta $FB
rot_bin_source_ready:
        lda rotating_bin_mirror
        bne rot_bin_copy_mirror
        ldy #0
rot_bin_copy_d8:
        lda ($FA),y
        sta $D800,y
        iny
        bne rot_bin_copy_d8
        inc $FB
        ldy #0
rot_bin_copy_d9:
        lda ($FA),y
        sta $D900,y
        iny
        bne rot_bin_copy_d9
        inc $FB
        ldy #0
rot_bin_copy_da:
        lda ($FA),y
        sta $DA00,y
        iny
        bne rot_bin_copy_da
        inc $FB
        ldy #0
rot_bin_copy_db:
        lda ($FA),y
        sta $DB00,y
        iny
        cpy #$E8
        bne rot_bin_copy_db
        jmp rot_bin_done
rot_bin_copy_mirror:
        lda #$00
        sta $FC
        lda #$D8
        sta $FD
        lda #25
        sta rotating_bin_rows_left
rot_bin_mirror_row:
        ldy #0
rot_bin_mirror_cell:
        lda ($FA),y
        sta ($FC),y
        iny
        cpy #40
        bne rot_bin_mirror_cell
        sec
        lda $FA
        sbc #40
        sta $FA
        lda $FB
        sbc #0
        sta $FB
        clc
        lda $FC
        adc #40
        sta $FC
        bcc rot_bin_dest_ok
        inc $FD
rot_bin_dest_ok:
        dec rotating_bin_rows_left
        bne rot_bin_mirror_row
rot_bin_done:
        pla
        tay
        pla
        tax
        pla
    ");
end;
// | Se usa SOLO en Stage 13.                                                     |
procedure AplicarMapaRotatorioBinMovido();
begin
    asm("
        pha
        txa
        pha
        tya
        pha
        lda #0
        sta rotating_bin_mirror
        lda rotating_lines_step
        cmp #1
        beq rot_move_step1
        cmp #2
        beq rot_move_step2
        cmp #3
        beq rot_move_step3
        cmp #5
        beq rot_move_step5
        cmp #6
        beq rot_move_step6
rot_move_step7:
        lda #$60
        sta $FA
        lda #$B4
        sta $FB
        lda #1
        sta rotating_bin_mirror
        jmp rot_move_source_ready
rot_move_step6:
        lda #$48
        sta $FA
        lda #$B8
        sta $FB
        lda #1
        sta rotating_bin_mirror
        jmp rot_move_source_ready
rot_move_step5:
        lda #$30
        sta $FA
        lda #$BC
        sta $FB
        lda #1
        sta rotating_bin_mirror
        jmp rot_move_source_ready
rot_move_step3:
        lda #$70
        sta $FA
        lda #$B8
        sta $FB
        jmp rot_move_source_ready
rot_move_step2:
        lda #$88
        sta $FA
        lda #$B4
        sta $FB
        jmp rot_move_source_ready
rot_move_step1:
        lda #$A0
        sta $FA
        lda #$B0
        sta $FB
rot_move_source_ready:
        lda #$00
        sta $FC
        lda #$D8
        sta $FD
        lda #25
        sta rotating_bin_rows_left
rot_move_row:
        lda rotating_move_offset
        beq rot_move_row_no_offset
        lda $FC
        sta $F8
        lda $FD
        sta $F9
        sec
        lda $FC
        sbc rotating_move_offset
        sta $FC
        lda $FD
        sbc #0
        sta $FD
        ldy rotating_move_offset
rot_move_chunk_a:
        lda ($FA),y
        sta ($FC),y
        iny
        cpy #40
        bne rot_move_chunk_a
        lda $F8
        sta $FC
        lda $F9
        sta $FD
        lda #40
        sec
        sbc rotating_move_offset
        sta $F7
        clc
        lda $FC
        adc $F7
        sta $FC
        lda $FD
        adc #0
        sta $FD
        ldy #0
rot_move_chunk_b:
        cpy rotating_move_offset
        beq rot_move_chunk_b_done
        lda ($FA),y
        sta ($FC),y
        iny
        jmp rot_move_chunk_b
rot_move_chunk_b_done:
        sec
        lda $FC
        sbc $F7
        sta $FC
        lda $FD
        sbc #0
        sta $FD
        jmp rot_move_row_done
rot_move_row_no_offset:
        ldy #0
rot_move_row_plain:
        lda ($FA),y
        sta ($FC),y
        iny
        cpy #40
        bne rot_move_row_plain
rot_move_row_done:
        lda rotating_bin_mirror
        bne rot_move_source_back
        clc
        lda $FA
        adc #40
        sta $FA
        bcc rot_move_source_done
        inc $FB
        jmp rot_move_source_done
rot_move_source_back:
        sec
        lda $FA
        sbc #40
        sta $FA
        lda $FB
        sbc #0
        sta $FB
rot_move_source_done:
        clc
        lda $FC
        adc #40
        sta $FC
        bcc rot_move_dest_done
        inc $FD
rot_move_dest_done:
        dec rotating_bin_rows_left
        beq rot_move_all_done
        jmp rot_move_row
rot_move_all_done:
        pla
        tay
        pla
        tax
        pla
    ");
end;
procedure AplicarLineasRotatorias();
begin
    if rotating_lines_step = 0 then begin
        linear_subdivision := 7;
        linear_mirror := 0;
        AplicarDegradeLineal();
    end;
    // Stage 11/12 = centrado. Stage 13 = desplazado.
    if rotating_lines_step = 1 then begin
        if rotating_move_enabled = 1 then begin
            AplicarMapaRotatorioBinMovido();
        end
        else begin
            AplicarMapaRotatorioBin();
        end;
    end;
    if rotating_lines_step = 2 then begin
        if rotating_move_enabled = 1 then begin
            AplicarMapaRotatorioBinMovido();
        end
        else begin
            AplicarMapaRotatorioBin();
        end;
    end;
    if rotating_lines_step = 3 then begin
        if rotating_move_enabled = 1 then begin
            AplicarMapaRotatorioBinMovido();
        end
        else begin
            AplicarMapaRotatorioBin();
        end;
    end;
    if rotating_lines_step = 4 then begin
        vertical_subdivision := 3;
        vertical_mirror := 0;
        if rotating_move_enabled = 1 then begin
            vertical_scroll_offset := rotating_move_offset;
        end
        else begin
            vertical_scroll_offset := 0;
        end;
        AplicarDegradeVertical();
    end;
    if rotating_lines_step = 5 then begin
        if rotating_move_enabled = 1 then begin
            AplicarMapaRotatorioBinMovido();
        end
        else begin
            AplicarMapaRotatorioBin();
        end;
    end;
    if rotating_lines_step = 6 then begin
        if rotating_move_enabled = 1 then begin
            AplicarMapaRotatorioBinMovido();
        end
        else begin
            AplicarMapaRotatorioBin();
        end;
    end;
    if rotating_lines_step = 7 then begin
        if rotating_move_enabled = 1 then begin
            AplicarMapaRotatorioBinMovido();
        end
        else begin
            AplicarMapaRotatorioBin();
        end;
    end;
end;
procedure ActualizarLineasRotatorias();
begin
    // Motor rotatorio usado solo por Stages 11/12.
    rotating_speed_current := rotating_lines_speed;
    if rotating_speed_current < 1 then begin
        rotating_speed_current := 1;
    end;
    if rotating_lines_counter < rotating_speed_current then begin
        inc(rotating_lines_counter);
    end;
    if rotating_lines_counter >= rotating_speed_current then begin
        if scroll_coarse_event = 0 then begin
            rotating_lines_counter := 0;
            if rotating_lines_direction = 0 then begin
                inc(rotating_lines_step);
                if rotating_lines_step > 7 then begin
                    rotating_lines_step := 0;
                end;
            end
            else begin
                if rotating_lines_step = 0 then begin
                    rotating_lines_step := 7;
                end
                else begin
                    dec(rotating_lines_step);
                end;
            end;
            // STAGE 13: DERIVA ESPACIAL CON REBOTE.
            if rotating_move_enabled = 1 then begin
                if rotating_move_direction = 0 then begin
                    if rotating_move_offset + rotating_move_step >= rotating_move_max then begin
                        rotating_move_offset := rotating_move_max;
                        rotating_move_direction := 1;
                    end
                    else begin
                        rotating_move_offset := rotating_move_offset + rotating_move_step;
                    end;
                end
                else begin
                    if rotating_move_offset <= rotating_move_step then begin
                        rotating_move_offset := 0;
                        rotating_move_direction := 0;
                        // Stage 13 completo 0 -> max -> 0.
                        // el retorno 0->max->0 NO dispara animacion de charset.
                    end
                    else begin
                        rotating_move_offset := rotating_move_offset - rotating_move_step;
                    end;
                end;
            end;
            AplicarLineasRotatorias();
        end;
    end;
end;
procedure AplicarHorizontalCompletoBlancoNegro();
begin
    linear_row := 0;
    while linear_row < 25 do begin
        asm("
            ldx linear_row
            lda color_lo,x
            sta $FC
            lda color_hi,x
            sta $FD
            lda horizontal_full_gradient,x
            ldy #39
stage5_full_gradient_row:
            sta ($FC),y
            dey
            bpl stage5_full_gradient_row
        ");
        inc(linear_row);
    end;
end;
procedure AplicarColorActual();
begin
    if color_mode = 0 then begin
        AplicarDegradeLineal();
    end;
    if color_mode = 1 then begin
        AplicarBlinkGlobal();
    end;
    if color_mode = 2 then begin
        asm("
            pha
            txa
            pha
            lda flat_color
            ldx #$00
fill_flat:
            sta $D800,x
            sta $D900,x
            sta $DA00,x
            inx
            bne fill_flat
            ldx #$00
fill_flat_rem:
            sta $DB00,x
            inx
            cpx #$E8
            bne fill_flat_rem
            pla
            tax
            pla
        ");
    end;
    if color_mode = 5 then begin
        AplicarDegradePeriodico();
    end;
    if color_mode = 6 then begin
        AplicarDegradeVertical();
    end;
    if color_mode = 7 then begin
        AplicarDegradeRadialCompleto();
    end;
    if color_mode = 8 then begin
        AplicarLineasRotatorias();
    end;
    if color_mode = 9 then begin
        AplicarHorizontalCompletoBlancoNegro();
    end;
end;
// | >>> FORWARD DECLARATIONS / STAGE 13                                        |
procedure RenderizarBinarios(); forward;
procedure PrepararBufferArriba(); forward;
procedure AplicarStageVisual(); forward;
procedure ActualizarAnimacionEnNegro(); forward;
// | >>> STAGE 13 :: PETSCII CENTRADO                                            |
procedure RenderizarStage13Centro();
begin
    RenderizarBinarios();
    map_idx := 0;
    src_idx := stage13_center_src_top;
    while map_idx < 25 do begin
        asm("
            ldx src_idx
            lda src_char_lo,x
            sta $22
            lda src_char_hi,x
            sta $23
            ldx map_idx
            lda screen_lo,x
            sta $24
            lda screen_hi,x
            sta $25
            lda screen_lo,x
            sta $FB
            lda screen_hi_b,x
            sta $FC
            ldy #39
stage13_center_copy_line:
            lda ($22),y
            sta ($24),y
            sta ($FB),y
            dey
            bpl stage13_center_copy_line
        ");
        inc(map_idx);
        inc(src_idx);
    end;
end;
// | >>> STAGE 13 :: SALIDA MANUAL                                               |
procedure SalirStage13Centro();
begin
    stage13_static_active := 0;
    anim_active := 0;
    RenderizarBinarios();
    screen_active := 0;
    screen_d018_real := $18;
    screen_d018_mask := $1A;
    vic_d018 := screen_d018_real;
    next_line := 42;
    direction := 1;
    fine_scroll := 7;
    vic_d011 := $17;
    speed_counter := 0;
    scroll_phase := 0;
    scroll_update_now := 0;
    scroll_coarse_event := 0;
    PrepararBufferArriba();
    show_stage := 14;
    AplicarStageVisual();
    ActualizarAnimacionEnNegro();
end;
