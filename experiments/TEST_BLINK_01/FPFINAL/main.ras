        rotating_lines_counter := 0;
        rotating_lines_step := 0;
        rotating_scroll_phase := 0;
        rotating_move_enabled := 0;
        rotating_move_offset := 0;
        stage13_static_active := 1;
        stage13_ghost_next_line := limit_down + 9;
        stage13_ghost_fine_scroll := 5;
        stage13_consumed_update := 0;
        // Stage 13: posicion simetrica aprobada (fuente 16, VIC fine scroll 3).
        vic_d011 := $13;
        RenderizarStage13Centro();
    end;
    // - STAGE 14 = PRIMER RADIAL. PETSCII ya puede venir activo desde Stage 13.
